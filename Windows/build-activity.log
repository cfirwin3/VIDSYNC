04:22:41 out   name.to_string()
04:22:41 out   };
04:22:41 out   for candidate in [dir.join(&file_name), dir.join("tools").join(&file_name)] {
04:22:41 out   if candidate.is_file() {
04:22:41 out   return candidate.to_string_lossy().into_owned();
04:22:41 out   }
04:22:41 out   }
04:22:41 out   }
04:22:41 out   }
04:22:41 out   if cfg!(windows) && !name.to_ascii_lowercase().ends_with(".exe") {
04:22:41 out   // Command::new("ffmpeg.exe") uses the Windows executable search path,
04:22:41 out   // so an ffmpeg installed with PATH keeps working too.
04:22:41 out   return format!("{name}.exe");
04:22:41 out   }
04:22:41 out   name.to_string()
04:22:41 out   }
