04:22:41 out   // Accept both a flat layout and a tools\ subfolder, which is handy
04:22:41 out   // when the player is packaged as a folder or an installer payload.
04:22:41 out   let file_name = if cfg!(windows) && !name.to_ascii_lowercase().ends_with(".exe") {
04:22:41 out   format!("{name}.exe")
