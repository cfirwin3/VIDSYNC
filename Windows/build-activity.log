03:58:12 out   #!/usr/bin/env bash
03:58:12 out   # Build a self-contained VIDSYNC AppImage.
03:58:12 out   #
03:58:12 out   # ./scripts/build-appimage.sh
03:58:12 out   #
03:58:12 out   # It downloads a static ffmpeg/ffprobe build and appimagetool into build/cache
03:58:12 out   # the first time, stages build/VIDSYNC.AppDir, and writes dist/*.AppImage.
03:58:12 out   # No FUSE is needed: the tool is run with APPIMAGE_EXTRACT_AND_RUN=1.
03:58:12 out   set -euo pipefail
03:58:12 out   ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
03:58:12 out   cd "$ROOT"
03:58:12 out   APP="VIDSYNC"
03:58:12 out   ARCH="${ARCH:-x86_64}"
03:58:12 out   VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
03:58:12 out   if [ -z "$VERSION" ]; then
03:58:12 out   echo "Could not read the version from Cargo.toml" >&2
03:58:12 out   exit 1
03:58:12 out   fi
03:58:12 out   case "$ARCH" in
03:58:12 out   x86_64)
03:58:12 out   FFMPEG_URL="https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
03:58:12 out   APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
03:58:12 out   ;;
03:58:12 out   *)
03:58:12 out   echo "Only x86_64 AppImages are supported by this script (got ARCH=$ARCH)." >&2
03:58:12 out   echo "Set ARCH=x86_64 or adapt the download URLs." >&2
03:58:12 out   exit 1
03:58:12 out   ;;
03:58:12 out   esac
03:58:12 out   BUILD="$ROOT/build"
03:58:12 out   CACHE="$BUILD/cache"
03:58:12 out   APPDIR="$BUILD/$APP.AppDir"
03:58:12 out   DIST="$ROOT/dist"
03:58:12 out   BIN="$ROOT/target/release/vidsync"
03:58:12 out   FF_DIR="$CACHE/ffmpeg-static"
03:58:12 out   FF_ARCHIVE="$CACHE/ffmpeg-static.tar.xz"
03:58:12 out   APPIMAGETOOL="$CACHE/appimagetool-$ARCH.AppImage"
03:58:12 out   OUT="$DIST/$APP-$VERSION-$ARCH.AppImage"
03:58:12 out   need() {
03:58:12 out   command -v "$1" >/dev/null 2>&1 || {
03:58:12 out   echo "Missing required command: $1" >&2
03:58:12 out   exit 1
03:58:12 out   }
03:58:12 out   }
03:58:12 out   need cargo
03:58:12 out   need curl
03:58:12 out   need tar
03:58:12 out   need xz
03:58:12 out   echo "==> Building release binary"
03:58:12 out   cargo build --release --locked
03:58:12 out   echo "==> Preparing build folders"
03:58:12 out   mkdir -p "$CACHE" "$DIST"
03:58:12 out   rm -rf "$APPDIR"
03:58:12 out   mkdir -p "$APPDIR/usr/bin" \
03:58:12 out   "$APPDIR/usr/share/applications" \
03:58:12 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps" \
03:58:12 out   "$APPDIR/usr/share/doc/vidsync"
03:58:12 out   echo "==> Fetching static ffmpeg and ffprobe (cached)"
03:58:12 out   if [ ! -x "$FF_DIR/ffmpeg" ] || [ ! -x "$FF_DIR/ffprobe" ]; then
03:58:12 out   if [ ! -f "$FF_ARCHIVE" ]; then
03:58:12 out   curl -fL --retry 3 --retry-delay 2 -o "$FF_ARCHIVE" "$FFMPEG_URL"
03:58:12 out   fi
03:58:12 out   rm -rf "$FF_DIR"
03:58:12 out   mkdir -p "$FF_DIR"
03:58:12 out   tar -xJf "$FF_ARCHIVE" -C "$FF_DIR" --strip-components=1
03:58:12 out   fi
03:58:12 out   echo "==> Fetching appimagetool (cached)"
03:58:12 out   if [ ! -x "$APPIMAGETOOL" ]; then
03:58:12 out   if [ ! -f "$APPIMAGETOOL" ]; then
03:58:12 out   curl -fL --retry 3 --retry-delay 2 -o "$APPIMAGETOOL" "$APPIMAGETOOL_URL"
03:58:12 out   fi
03:58:12 out   chmod +x "$APPIMAGETOOL"
03:58:12 out   fi
03:58:12 out   echo "==> Staging AppDir"
03:58:12 out   install -Dm755 "$BIN" "$APPDIR/usr/bin/vidsync"
03:58:12 out   install -Dm755 "$FF_DIR/ffmpeg" "$APPDIR/usr/bin/ffmpeg"
03:58:12 out   install -Dm755 "$FF_DIR/ffprobe" "$APPDIR/usr/bin/ffprobe"
03:58:12 out   install -Dm644 "$ROOT/assets/vidsync.png" \
03:58:12 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidsync.png"
03:58:12 out   install -Dm644 "$ROOT/scripts/vidsync.desktop" \
03:58:12 out   "$APPDIR/usr/share/applications/vidsync.desktop"
03:58:12 out   install -Dm644 "$ROOT/README.md" "$APPDIR/usr/share/doc/vidsync/README.md"
03:58:12 out   install -Dm644 "$ROOT/MECHANICS.md" "$APPDIR/usr/share/doc/vidsync/MECHANICS.md"
03:58:12 out   install -Dm644 "$ROOT/LICENSE" "$APPDIR/usr/share/doc/vidsync/LICENSE"
03:58:12 out   install -Dm644 "$ROOT/assets/fonts/LICENSE-DejaVu.txt" \
03:58:12 out   "$APPDIR/usr/share/doc/vidsync/LICENSE-DejaVu.txt"
03:58:12 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidsync.png" "$APPDIR/vidsync.png"
03:58:12 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidsync.png" "$APPDIR/.DirIcon"
03:58:12 out   cp "$APPDIR/usr/share/applications/vidsync.desktop" "$APPDIR/vidsync.desktop"
03:58:12 out   cat > "$APPDIR/AppRun" <<'APPRUN'
03:58:12 out   #!/bin/sh
03:58:12 out   # AppRun for VIDSYNC. Keep ffmpeg and ffprobe next to the binary.
03:58:12 out   set -eu
03:58:12 out   HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
03:58:12 out   export APPDIR="$HERE"
03:58:12 out   export PATH="$HERE/usr/bin:${PATH:-/usr/bin:/bin}"
03:58:12 out   exec "$HERE/usr/bin/vidsync" "$@"
03:58:12 out   APPRUN
03:58:12 out   chmod +x "$APPDIR/AppRun"
03:58:12 out   if command -v desktop-file-validate >/dev/null 2>&1; then
03:58:12 out   desktop-file-validate "$APPDIR/usr/share/applications/vidsync.desktop" || true
03:58:12 out   fi
03:58:12 out   echo "==> Packing AppImage"
03:58:12 out   rm -f "$OUT"
03:58:12 out   APPIMAGE_EXTRACT_AND_RUN=1 ARCH="$ARCH" \
03:58:12 out   "$APPIMAGETOOL" --no-appstream "$APPDIR" "$OUT"
