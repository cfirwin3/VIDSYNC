02:05:47 out   //! Audacity 4.0 timecode over the accessibility bus.
02:05:47 out   //!
02:05:47 out   //! Audacity 4.0 is a Qt application and publishes its playback position as an
02:05:47 out   //! AT-SPI accessible value (`Playback position:00 h 00 m 11.037 s`). Reading
02:05:47 out   //! that value is independent of which window is on top, so VIDSYNC can follow
02:05:47 out   //! Audacity even while it is behind another window or minimised.
02:05:47 out   //!
02:05:47 out   //! A background thread discovers the Audacity accessible tree, caches the node
02:05:47 out   //! that holds the timecode, and polls it about thirty times a second. The UI
02:05:47 out   //! only reads a small snapshot, so a slow or missing Audacity never stalls the
02:05:47 out   //! video.
02:05:47 out   use std::error::Error;
02:05:47 out   use std::sync::atomic::{AtomicBool, Ordering};
02:05:47 out   use std::sync::{Arc, Mutex};
02:05:47 out   use std::thread;
02:05:47 out   use std::time::{Duration, Instant};
02:05:47 out   use zbus::blocking::{Connection, Proxy};
02:05:47 out   use zbus::zvariant::{OwnedObjectPath, OwnedValue};
02:05:47 out   const POLL: Duration = Duration::from_millis(33);
02:05:47 out   const REDISCOVER: Duration = Duration::from_millis(1500);
02:05:47 out   #[derive(Clone, Debug, Default)]
02:05:47 out   pub struct Snapshot {
02:05:47 out   pub connected: bool,
02:05:47 out   pub position: Option<f64>,
02:05:47 out   /// True while the timecode has changed recently, i.e. Audacity is running.
02:05:47 out   pub moving: bool,
02:05:47 out   /// True when Audacity's timecode display uses the requested
02:05:47 out   /// `00h00m00.000s` style rather than a bare colon clock.
02:05:47 out   pub format_ok: bool,
02:05:47 out   pub message: String,
02:05:47 out   }
02:05:47 out   struct TimecodeNode {
02:05:47 out   conn: Connection,
02:05:47 out   bus: String,
02:05:47 out   path: String,
02:05:47 out   }
02:05:47 out   impl TimecodeNode {
02:05:47 out   fn read(&self) -> Result<String, Box<dyn Error>> {
02:05:47 out   let props = Proxy::new(
02:05:47 out   &self.conn,
