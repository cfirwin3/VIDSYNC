22:53:21 out   rounded_rect(
22:53:21 out   off.x,
22:53:21 out   off.y,
22:53:21 out   off.w,
22:53:21 out   off.h,
22:53:21 out   7.0,
22:53:21 out   Color::new(0.027, 0.033, 0.043, 1.0),
22:53:21 out   );
22:53:21 out   // mute icon: little speaker body plus a slash
22:53:21 out   draw_rectangle(off.x + 12.0, off.y + 9.0, 5.0, 8.0, MUTED);
22:53:21 out   draw_triangle(
22:53:21 out   vec2(off.x + 17.0, off.y + 9.0),
22:53:21 out   vec2(off.x + 17.0, off.y + 17.0),
22:53:21 out   vec2(off.x + 23.0, off.y + 13.0),
22:53:21 out   MUTED,
22:53:21 out   );
22:53:21 out   draw_line(
22:53:21 out   off.x + 9.0,
22:53:21 out   off.y + 20.0,
