14:38:41 out   Some(old_focus)
14:38:41 out   } else {
14:38:41 out   None
14:38:41 out   });
14:38:41 out   if let Some(player) = player {
14:38:41 out   (x.raise_window)(dpy, player);
14:38:41 out   (x.set_input_focus)(dpy, player, REVERT_TO_PARENT, 0);
14:38:41 out   (x.sync)(dpy, 0);
14:38:41 out   }
14:38:41 out   Ok((target, title))
14:38:41 out   })();
14:38:41 out   (x.close_display)(dpy);
14:38:41 out   outcome
14:38:41 out   }
14:38:41 out   };
14:38:41 out   match result {
14:38:41 out   Ok((window, title)) => {
14:38:41 out   self.target = Some(window);
14:38:41 out   self.last_ok = true;
14:38:41 out   self.last_message = format!("Sent Space to {title}");
14:38:41 out   Ok(())
14:38:41 out   }
14:38:41 out   Err(e) => {
