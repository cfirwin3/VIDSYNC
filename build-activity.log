02:05:47 out   self.path.as_str(),
02:05:47 out   "org.freedesktop.DBus.Properties",
02:05:47 out   )?;
02:05:47 out   let value: OwnedValue = props.call("Get", &("org.a11y.atspi.Accessible", "Name"))?;
02:05:47 out   Ok(String::try_from(value)?)
02:05:47 out   }
02:05:47 out   }
