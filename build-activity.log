14:38:54 out   #!/usr/bin/env python3
14:38:54 out   """Draw the VidCue app icon.
14:38:54 out   Run from the app folder: python3 scripts/make-icon.py
14:38:54 out   Requires Pillow. The committed PNG is used by the AppImage build; this script
14:38:54 out   exists so the icon can be regenerated or recoloured later.
14:38:54 out   """
14:38:54 out   from pathlib import Path
14:38:54 out   from PIL import Image, ImageDraw
14:38:54 out   ROOT = Path(__file__).resolve().parent.parent
14:38:54 out   OUT = ROOT / "assets" / "vidcue.png"
14:38:54 out   OUTLINE = (170, 112, 236, 255)
14:38:54 out   PURPLE = (176, 122, 240, 255)
14:38:54 out   BRIGHT = (214, 178, 255, 255)
14:38:54 out   HIGHLIGHT = (232, 212, 255, 255)
14:38:54 out   HOLE = (30, 20, 43, 255)
14:38:54 out   DARK = (20, 13, 29, 255)
14:38:54 out   def build(size: int) -> Image.Image:
14:38:54 out   s = size / 512.0
14:38:54 out   def r(*values):
14:38:54 out   return tuple(round(v * s) for v in values)
14:38:54 out   img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
14:38:54 out   # Purple shade, lighter at the top-left.
14:38:54 out   mask = Image.new("L", (size, size), 0)
14:38:54 out   md = ImageDraw.Draw(mask)
14:38:54 out   md.rounded_rectangle(r(12, 12, 500, 500), radius=r(112)[0], fill=255)
14:38:54 out   shade = Image.new("RGB", (size, size), DARK[:3])
14:38:54 out   sd = ImageDraw.Draw(shade)
14:38:54 out   for y in range(size):
14:38:54 out   t = y / max(1, size - 1)
14:38:54 out   top = (48, 30, 66)
14:38:54 out   bottom = (19, 12, 28)
14:38:54 out   c = tuple(round(top[i] + (bottom[i] - top[i]) * t) for i in range(3))
14:38:54 out   sd.line([(0, y), (size, y)], fill=c)
14:38:54 out   img.paste(shade, (0, 0), mask)
14:38:54 out   d = ImageDraw.Draw(img)
14:38:54 out   d.rounded_rectangle(r(12, 12, 500, 500), radius=r(112)[0], outline=OUTLINE,
14:38:54 out   width=max(1, r(9)[0]))
14:38:54 out   # Film strip holes along the top and bottom.
14:38:54 out   for x in (92, 172, 252, 332, 412):
14:38:54 out   d.rounded_rectangle(r(x, 56, x + 36, 82), radius=r(6)[0], fill=HOLE)
14:38:54 out   d.rounded_rectangle(r(x, 430, x + 36, 456), radius=r(6)[0], fill=HOLE)
14:38:54 out   # Purple play mark with a soft inner highlight.
14:38:54 out   d.polygon([r(198, 150), r(198, 362), r(372, 256)], fill=PURPLE)
14:38:54 out   d.polygon([r(220, 190), r(220, 322), r(330, 256)], fill=BRIGHT)
14:38:54 out   d.polygon([r(238, 218), r(238, 294), r(300, 256)], fill=HIGHLIGHT)
14:38:54 out   return img
14:38:54 out   def main() -> None:
14:38:54 out   OUT.parent.mkdir(parents=True, exist_ok=True)
14:38:54 out   build(512).resize((256, 256), Image.LANCZOS).save(OUT)
14:38:54 out   print(f"wrote {OUT}")
14:38:54 out   if __name__ == "__main__":
14:38:54 out   main()
14:38:54 out   #!/usr/bin/env bash
14:38:54 out   # Build a self-contained VidCue AppImage.
14:38:54 out   #
14:38:54 out   # ./scripts/build-appimage.sh
14:38:54 out   #
14:38:54 out   # It downloads a static ffmpeg/ffprobe build and appimagetool into build/cache
14:38:54 out   # the first time, stages build/VidCue.AppDir, and writes dist/*.AppImage.
14:38:54 out   # No FUSE is needed: the tool is run with APPIMAGE_EXTRACT_AND_RUN=1.
14:38:54 out   set -euo pipefail
14:38:54 out   ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
14:38:54 out   cd "$ROOT"
14:38:54 out   APP="VidCue"
14:38:54 out   ARCH="${ARCH:-x86_64}"
14:38:54 out   VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
14:38:54 out   if [ -z "$VERSION" ]; then
14:38:54 out   echo "Could not read the version from Cargo.toml" >&2
14:38:54 out   exit 1
14:38:54 out   fi
14:38:54 out   case "$ARCH" in
14:38:54 out   x86_64)
14:38:54 out   FFMPEG_URL="https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
14:38:54 out   APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
14:38:54 out   ;;
14:38:54 out   *)
14:38:54 out   echo "Only x86_64 AppImages are supported by this script (got ARCH=$ARCH)." >&2
14:38:54 out   echo "Set ARCH=x86_64 or adapt the download URLs." >&2
14:38:54 out   exit 1
14:38:54 out   ;;
14:38:54 out   esac
14:38:54 out   BUILD="$ROOT/build"
14:38:54 out   CACHE="$BUILD/cache"
14:38:54 out   APPDIR="$BUILD/$APP.AppDir"
14:38:54 out   DIST="$ROOT/dist"
14:38:54 out   BIN="$ROOT/target/release/cue-video-player"
14:38:54 out   FF_DIR="$CACHE/ffmpeg-static"
14:38:54 out   FF_ARCHIVE="$CACHE/ffmpeg-static.tar.xz"
14:38:54 out   APPIMAGETOOL="$CACHE/appimagetool-$ARCH.AppImage"
14:38:54 out   OUT="$DIST/$APP-$VERSION-$ARCH.AppImage"
14:38:54 out   need() {
14:38:54 out   command -v "$1" >/dev/null 2>&1 || {
14:38:54 out   echo "Missing required command: $1" >&2
14:38:54 out   exit 1
14:38:54 out   }
14:38:54 out   }
14:38:54 out   need cargo
14:38:54 out   need curl
14:38:54 out   need tar
14:38:54 out   need xz
14:38:54 out   echo "==> Building release binary"
14:38:54 out   cargo build --release --locked
14:38:54 out   echo "==> Preparing build folders"
14:38:54 out   mkdir -p "$CACHE" "$DIST"
14:38:54 out   rm -rf "$APPDIR"
14:38:54 out   mkdir -p "$APPDIR/usr/bin" \
14:38:54 out   "$APPDIR/usr/share/applications" \
14:38:54 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps" \
14:38:54 out   "$APPDIR/usr/share/doc/vidcue"
14:38:54 out   echo "==> Fetching static ffmpeg and ffprobe (cached)"
14:38:54 out   if [ ! -x "$FF_DIR/ffmpeg" ] || [ ! -x "$FF_DIR/ffprobe" ]; then
14:38:54 out   if [ ! -f "$FF_ARCHIVE" ]; then
14:38:54 out   curl -fL --retry 3 --retry-delay 2 -o "$FF_ARCHIVE" "$FFMPEG_URL"
14:38:54 out   fi
14:38:54 out   rm -rf "$FF_DIR"
14:38:54 out   mkdir -p "$FF_DIR"
14:38:54 out   tar -xJf "$FF_ARCHIVE" -C "$FF_DIR" --strip-components=1
14:38:54 out   fi
14:38:54 out   echo "==> Fetching appimagetool (cached)"
14:38:54 out   if [ ! -x "$APPIMAGETOOL" ]; then
14:38:54 out   if [ ! -f "$APPIMAGETOOL" ]; then
14:38:54 out   curl -fL --retry 3 --retry-delay 2 -o "$APPIMAGETOOL" "$APPIMAGETOOL_URL"
14:38:54 out   fi
14:38:54 out   chmod +x "$APPIMAGETOOL"
14:38:54 out   fi
14:38:54 out   echo "==> Staging AppDir"
14:38:54 out   install -Dm755 "$BIN" "$APPDIR/usr/bin/vidcue"
14:38:54 out   install -Dm755 "$FF_DIR/ffmpeg" "$APPDIR/usr/bin/ffmpeg"
14:38:54 out   install -Dm755 "$FF_DIR/ffprobe" "$APPDIR/usr/bin/ffprobe"
14:38:54 out   install -Dm644 "$ROOT/assets/vidcue.png" \
14:38:54 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png"
14:38:54 out   install -Dm644 "$ROOT/scripts/vidcue.desktop" \
14:38:54 out   "$APPDIR/usr/share/applications/vidcue.desktop"
14:38:54 out   install -Dm644 "$ROOT/README.md" "$APPDIR/usr/share/doc/vidcue/README.md"
14:38:54 out   install -Dm644 "$ROOT/MECHANICS.md" "$APPDIR/usr/share/doc/vidcue/MECHANICS.md"
14:38:54 out   install -Dm644 "$ROOT/LICENSE" "$APPDIR/usr/share/doc/vidcue/LICENSE"
14:38:54 out   install -Dm644 "$ROOT/assets/fonts/LICENSE-DejaVu.txt" \
14:38:54 out   "$APPDIR/usr/share/doc/vidcue/LICENSE-DejaVu.txt"
14:38:54 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png" "$APPDIR/vidcue.png"
14:38:54 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png" "$APPDIR/.DirIcon"
14:38:54 out   cp "$APPDIR/usr/share/applications/vidcue.desktop" "$APPDIR/vidcue.desktop"
14:38:54 out   cat > "$APPDIR/AppRun" <<'APPRUN'
14:38:54 out   #!/bin/sh
14:38:54 out   # AppRun for VidCue. Keep ffmpeg and ffprobe next to the binary.
14:38:54 out   set -eu
14:38:54 out   HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
14:38:54 out   export APPDIR="$HERE"
14:38:54 out   export PATH="$HERE/usr/bin:${PATH:-/usr/bin:/bin}"
14:38:54 out   exec "$HERE/usr/bin/vidcue" "$@"
14:38:54 out   APPRUN
14:38:54 out   chmod +x "$APPDIR/AppRun"
14:38:54 out   if command -v desktop-file-validate >/dev/null 2>&1; then
14:38:54 out   desktop-file-validate "$APPDIR/usr/share/applications/vidcue.desktop" || true
14:38:54 out   fi
14:38:54 out   echo "==> Packing AppImage"
14:38:54 out   rm -f "$OUT"
14:38:54 out   APPIMAGE_EXTRACT_AND_RUN=1 ARCH="$ARCH" \
14:38:54 out   "$APPIMAGETOOL" --no-appstream "$APPDIR" "$OUT"
14:38:54 out   chmod +x "$OUT"
14:38:54 out   echo
14:38:54 out   echo "Built $OUT"
14:38:54 out   ls -lh "$OUT"
14:38:54 out   [Desktop Entry]
14:38:54 out   Type=Application
14:38:54 out   Name=VIDCUE
14:38:54 out   GenericName=Video Player
14:38:54 out   Comment=Video-only player with a typed start cue and Audacity transport
