14:38:48 out   fn count_pixels<F>(img: &Image, rect: Rect, scale: f32, f: F) -> usize
14:38:48 out   where
14:38:48 out   F: Fn(u8, u8, u8) -> bool,
14:38:48 out   {
14:38:48 out   let iw = img.width as usize;
14:38:48 out   let ih = img.height as usize;
14:38:48 out   if iw == 0 || ih == 0 {
14:38:48 out   return 0;
14:38:48 out   }
14:38:48 out   let x0 = (rect.x * scale).max(0.0) as usize;
14:38:48 out   let x1 = ((rect.x + rect.w) * scale).min(iw as f32) as usize;
14:38:48 out   let y0 = (rect.y * scale).max(0.0) as usize;
14:38:48 out   let y1 = ((rect.y + rect.h) * scale).min(ih as f32) as usize;
14:38:48 out   let mut count = 0;
14:38:48 out   for sy in y0..y1 {
14:38:48 out   let iy = ih - 1 - sy;
14:38:48 out   for x in x0..x1 {
14:38:48 out   let idx = (iy * iw + x) * 4;
14:38:48 out   if idx + 3 < img.bytes.len()
14:38:48 out   && f(img.bytes[idx], img.bytes[idx + 1], img.bytes[idx + 2])
14:38:48 out   {
14:38:48 out   count += 1;
14:38:48 out   }
14:38:48 out   }
14:38:48 out   }
14:38:48 out   count
14:38:48 out   }
