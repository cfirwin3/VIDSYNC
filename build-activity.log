16:04:47 out   /// Draw text with its visual top-left corner at (x, y).
16:04:47 out   pub fn text_left(font: &Font, s: &str, x: f32, y: f32, size: u16, color: Color) {
16:04:47 out   let d = measure_text(s, Some(font), size, 1.0);
