16:04:47 out   let h = size * 0.86;
16:04:47 out   let w = (size * 0.26).max(2.0);
16:04:47 out   let gap = (size * 0.22).max(2.0);
16:04:47 out   draw_rectangle(cx - gap / 2.0 - w, cy - h / 2.0, w, h, color);
16:04:47 out   draw_rectangle(cx + gap / 2.0, cy - h / 2.0, w, h, color);
16:04:47 out   }
