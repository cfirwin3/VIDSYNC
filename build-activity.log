01:40:11 out   + let Ok(value) = serde_json::from_str::<serde_json::Value>(text) else {
01:40:11 out   + return;
01:40:11 out   + };
01:40:11 out   + if let Some(mode) = value.get("mode").and_then(|v| v.as_str()) {
01:40:11 out   + set_light_mode(mode.eq_ignore_ascii_case("light"));
01:40:11 out   + }
01:40:11 out   + if let Some(accent) = value.get("accent").and_then(|v| v.as_str()) {
01:40:11 out   + if let Some(theme) = THEMES
01:40:11 out   + .iter()
01:40:11 out   + .find(|theme| theme.label().eq_ignore_ascii_case(accent))
01:40:11 out   + {
01:40:11 out   + set_theme(*theme);
01:40:11 out   + }
01:40:11 out   + }
01:40:11 out   +}
01:40:11 out   +
01:40:11 out   +/// Restore the last dark/light mode and accent colour. Missing or unreadable
01:40:11 out   +/// settings simply keep the built-in defaults (dark and purple).
