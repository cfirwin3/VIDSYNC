17:35:43 out   /// Scale the bundled app icon down to the three sizes the window manager asks
17:35:43 out   /// for. The icon is the same rounded tile and play mark drawn beside the name.
17:35:43 out   fn icon_at(source: &Image, size: usize) -> Vec<u8> {
17:35:43 out   let mut out = vec![0u8; size * size * 4];
17:35:43 out   let sw = source.width as usize;
17:35:43 out   let sh = source.height as usize;
17:35:43 out   if sw == 0 || sh == 0 {
17:35:43 out   return out;
17:35:43 out   }
17:35:43 out   for y in 0..size {
17:35:43 out   let sy = ((y as f32 + 0.5) * sh as f32 / size as f32) as usize;
17:35:43 out   let sy = sy.min(sh - 1);
17:35:43 out   for x in 0..size {
17:35:43 out   let sx = ((x as f32 + 0.5) * sw as f32 / size as f32) as usize;
17:35:43 out   let sx = sx.min(sw - 1);
17:35:43 out   let src = (sy * sw + sx) * 4;
17:35:43 out   let dst = (y * size + x) * 4;
17:35:43 out   if src + 3 < source.bytes.len() {
17:35:43 out   out[dst..dst + 4].copy_from_slice(&source.bytes[src..src + 4]);
17:35:43 out   }
17:35:43 out   }
17:35:43 out   }
17:35:43 out   out
17:35:43 out   }
