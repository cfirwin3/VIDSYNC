17:36:04 out   #!/usr/bin/env bash
17:36:04 out   # Build a self-contained VIDSYNC AppImage.
17:36:04 out   #
17:36:04 out   # ./scripts/build-appimage.sh
17:36:04 out   #
17:36:04 out   # It downloads a static ffmpeg/ffprobe build and appimagetool into build/cache
17:36:04 out   # the first time, stages build/VIDSYNC.AppDir, and writes dist/*.AppImage.
17:36:04 out   # No FUSE is needed: the tool is run with APPIMAGE_EXTRACT_AND_RUN=1.
17:36:04 out   set -euo pipefail
17:36:04 out   ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
17:36:04 out   cd "$ROOT"
17:36:04 out   APP="VIDSYNC"
17:36:04 out   ARCH="${ARCH:-x86_64}"
17:36:04 out   VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
17:36:04 out   if [ -z "$VERSION" ]; then
17:36:04 out   echo "Could not read the version from Cargo.toml" >&2
17:36:04 out   exit 1
17:36:04 out   fi
17:36:04 out   case "$ARCH" in
17:36:04 out   x86_64)
17:36:04 out   FFMPEG_URL="https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
17:36:04 out   APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
17:36:04 out   ;;
17:36:04 out   *)
17:36:04 out   echo "Only x86_64 AppImages are supported by this script (got ARCH=$ARCH)." >&2
17:36:04 out   echo "Set ARCH=x86_64 or adapt the download URLs." >&2
17:36:04 out   exit 1
17:36:04 out   ;;
17:36:04 out   esac
17:36:04 out   BUILD="$ROOT/build"
17:36:04 out   CACHE="$BUILD/cache"
17:36:04 out   APPDIR="$BUILD/$APP.AppDir"
17:36:04 out   DIST="$ROOT/dist"
17:36:04 out   BIN="$ROOT/target/release/vidsync"
17:36:04 out   FF_DIR="$CACHE/ffmpeg-static"
17:36:04 out   FF_ARCHIVE="$CACHE/ffmpeg-static.tar.xz"
17:36:04 out   APPIMAGETOOL="$CACHE/appimagetool-$ARCH.AppImage"
17:36:04 out   OUT="$DIST/$APP-$VERSION-$ARCH.AppImage"
17:36:04 out   need() {
17:36:04 out   command -v "$1" >/dev/null 2>&1 || {
17:36:04 out   echo "Missing required command: $1" >&2
17:36:04 out   exit 1
17:36:04 out   }
17:36:04 out   }
17:36:04 out   need cargo
17:36:04 out   need curl
17:36:04 out   need tar
17:36:04 out   need xz
17:36:04 out   echo "==> Building release binary"
17:36:04 out   cargo build --release --locked
17:36:04 out   echo "==> Preparing build folders"
17:36:04 out   mkdir -p "$CACHE" "$DIST"
17:36:04 out   rm -rf "$APPDIR"
17:36:04 out   mkdir -p "$APPDIR/usr/bin" \
17:36:04 out   "$APPDIR/usr/share/applications" \
17:36:04 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps" \
17:36:04 out   "$APPDIR/usr/share/doc/vidsync"
17:36:04 out   echo "==> Fetching static ffmpeg and ffprobe (cached)"
17:36:04 out   if [ ! -x "$FF_DIR/ffmpeg" ] || [ ! -x "$FF_DIR/ffprobe" ]; then
17:36:04 out   if [ ! -f "$FF_ARCHIVE" ]; then
17:36:04 out   curl -fL --retry 3 --retry-delay 2 -o "$FF_ARCHIVE" "$FFMPEG_URL"
17:36:04 out   fi
17:36:04 out   rm -rf "$FF_DIR"
17:36:04 out   mkdir -p "$FF_DIR"
17:36:04 out   tar -xJf "$FF_ARCHIVE" -C "$FF_DIR" --strip-components=1
17:36:04 out   fi
17:36:04 out   echo "==> Fetching appimagetool (cached)"
17:36:04 out   if [ ! -x "$APPIMAGETOOL" ]; then
17:36:04 out   if [ ! -f "$APPIMAGETOOL" ]; then
17:36:04 out   curl -fL --retry 3 --retry-delay 2 -o "$APPIMAGETOOL" "$APPIMAGETOOL_URL"
17:36:04 out   fi
17:36:04 out   chmod +x "$APPIMAGETOOL"
17:36:04 out   fi
17:36:04 out   echo "==> Staging AppDir"
17:36:04 out   install -Dm755 "$BIN" "$APPDIR/usr/bin/vidsync"
17:36:04 out   install -Dm755 "$FF_DIR/ffmpeg" "$APPDIR/usr/bin/ffmpeg"
17:36:04 out   install -Dm755 "$FF_DIR/ffprobe" "$APPDIR/usr/bin/ffprobe"
17:36:04 out   install -Dm644 "$ROOT/assets/vidsync.png" \
17:36:04 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidsync.png"
17:36:04 out   install -Dm644 "$ROOT/scripts/vidsync.desktop" \
17:36:04 out   "$APPDIR/usr/share/applications/vidsync.desktop"
17:36:04 out   install -Dm644 "$ROOT/README.md" "$APPDIR/usr/share/doc/vidsync/README.md"
17:36:04 out   install -Dm644 "$ROOT/MECHANICS.md" "$APPDIR/usr/share/doc/vidsync/MECHANICS.md"
17:36:04 out   install -Dm644 "$ROOT/LICENSE" "$APPDIR/usr/share/doc/vidsync/LICENSE"
17:36:04 out   install -Dm644 "$ROOT/assets/fonts/LICENSE-DejaVu.txt" \
17:36:04 out   "$APPDIR/usr/share/doc/vidsync/LICENSE-DejaVu.txt"
17:36:04 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidsync.png" "$APPDIR/vidsync.png"
17:36:04 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidsync.png" "$APPDIR/.DirIcon"
17:36:04 out   cp "$APPDIR/usr/share/applications/vidsync.desktop" "$APPDIR/vidsync.desktop"
17:36:04 out   cat > "$APPDIR/AppRun" <<'APPRUN'
17:36:04 out   #!/bin/sh
17:36:04 out   # AppRun for VIDSYNC. Keep ffmpeg and ffprobe next to the binary.
17:36:04 out   set -eu
17:36:04 out   HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
17:36:04 out   export APPDIR="$HERE"
17:36:04 out   export PATH="$HERE/usr/bin:${PATH:-/usr/bin:/bin}"
17:36:04 out   exec "$HERE/usr/bin/vidsync" "$@"
17:36:04 out   APPRUN
17:36:04 out   chmod +x "$APPDIR/AppRun"
17:36:04 out   if command -v desktop-file-validate >/dev/null 2>&1; then
17:36:04 out   desktop-file-validate "$APPDIR/usr/share/applications/vidsync.desktop" || true
17:36:04 out   fi
17:36:04 out   echo "==> Packing AppImage"
17:36:04 out   rm -f "$OUT"
17:36:04 out   APPIMAGE_EXTRACT_AND_RUN=1 ARCH="$ARCH" \
17:36:04 out   "$APPIMAGETOOL" --no-appstream "$APPDIR" "$OUT"
17:36:04 out   chmod +x "$OUT"
17:36:04 out   echo
17:36:04 out   echo "Built $OUT"
17:36:04 out   ls -lh "$OUT"
