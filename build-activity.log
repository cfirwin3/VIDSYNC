16:04:47 out   }
16:04:47 out   /// Shorten a string with an ellipsis so that it fits in max_w.
16:04:47 out   pub fn ellipsize(font: &Font, s: &str, size: u16, max_w: f32) -> String {
16:04:47 out   if text_width(font, s, size) <= max_w {
16:04:47 out   return s.to_string();
16:04:47 out   }
16:04:47 out   let ell = "…";
16:04:47 out   let ell_w = text_width(font, ell, size);
16:04:47 out   let mut out = String::new();
16:04:47 out   for ch in s.chars() {
16:04:47 out   let mut candidate = out.clone();
16:04:47 out   candidate.push(ch);
16:04:47 out   if text_width(font, &candidate, size) + ell_w > max_w {
16:04:47 out   break;
16:04:47 out   }
16:04:47 out   out = candidate;
16:04:47 out   }
16:04:47 out   out.push('…');
16:04:47 out   out
16:04:47 out   }
