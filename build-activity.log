22:53:21 out   return 0;
22:53:21 out   }
22:53:21 out   let x0 = (rect.x * scale).max(0.0) as usize;
22:53:21 out   let x1 = ((rect.x + rect.w) * scale).min(iw as f32) as usize;
22:53:21 out   let y0 = (rect.y * scale).max(0.0) as usize;
22:53:21 out   let y1 = ((rect.y + rect.h) * scale).min(ih as f32) as usize;
22:53:21 out   let mut count = 0;
22:53:21 out   for sy in y0..y1 {
22:53:21 out   let iy = ih - 1 - sy;
22:53:21 out   for x in x0..x1 {
22:53:21 out   let idx = (iy * iw + x) * 4;
22:53:21 out   if idx + 3 < img.bytes.len()
22:53:21 out   && f(img.bytes[idx], img.bytes[idx + 1], img.bytes[idx + 2])
22:53:21 out   {
22:53:21 out   count += 1;
22:53:21 out   }
22:53:21 out   }
22:53:21 out   }
22:53:21 out   count
22:53:21 out   }
