14:38:39 out   rounded_rect(r.x, r.y, r.w, r.h, 9.0, bg);
14:38:39 out   let font = &fonts.bold;
14:38:39 out   text_in_rect(font, label, r, 13, fg);
14:38:39 out   enabled && hovered && is_mouse_button_pressed(MouseButton::Left)
14:38:39 out   }
