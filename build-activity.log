02:04:50 out   }
02:04:50 out   fn count_pixels<F>(img: &Image, rect: Rect, scale: f32, f: F) -> usize
02:04:50 out   where
02:04:50 out   F: Fn(u8, u8, u8) -> bool,
02:04:50 out   {
02:04:50 out   let iw = img.width as usize;
02:04:50 out   let ih = img.height as usize;
02:04:50 out   if iw == 0 || ih == 0 {
02:04:50 out   return 0;
02:04:50 out   }
02:04:50 out   let x0 = (rect.x * scale).max(0.0) as usize;
02:04:50 out   let x1 = ((rect.x + rect.w) * scale).min(iw as f32) as usize;
02:04:50 out   let y0 = (rect.y * scale).max(0.0) as usize;
02:04:50 out   let y1 = ((rect.y + rect.h) * scale).min(ih as f32) as usize;
02:04:50 out   let mut count = 0;
02:04:50 out   for sy in y0..y1 {
02:04:50 out   let iy = ih - 1 - sy;
02:04:50 out   for x in x0..x1 {
02:04:50 out   let idx = (iy * iw + x) * 4;
02:04:50 out   if idx + 3 < img.bytes.len()
02:04:50 out   && f(img.bytes[idx], img.bytes[idx + 1], img.bytes[idx + 2])
02:04:50 out   {
02:04:50 out   count += 1;
02:04:50 out   }
02:04:50 out   }
02:04:50 out   }
02:04:50 out   count
02:04:50 out   }
