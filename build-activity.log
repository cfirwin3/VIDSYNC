16:04:47 out   ),
16:04:47 out   };
16:04:47 out   rounded_rect(r.x, r.y, r.w, r.h, 9.0, bg);
16:04:47 out   let font = &fonts.bold;
16:04:47 out   text_in_rect(font, label, r, 13, fg);
