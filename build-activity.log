02:04:50 out   }
02:04:50 out   let held = !app.player.playing && (app.player.position - 4.0).abs() < 0.02;
02:04:50 out   let millis_shown = app.timecode_text() == "00:00:04.000";
02:04:50 out   let p0 = app.player.position;
02:04:50 out   for i in 0..45 {
