01:04:15 out   use std::sync::atomic::{AtomicBool, Ordering};
01:04:15 out   use std::sync::{Arc, Mutex};
01:04:15 out   use std::thread;
01:04:15 out   use std::time::{Duration, Instant};
01:04:15 out   use zbus::blocking::{Connection, Proxy};
01:04:15 out   use zbus::zvariant::{OwnedObjectPath, OwnedValue};
01:04:15 out   const POLL: Duration = Duration::from_millis(33);
01:04:15 out   const REDISCOVER: Duration = Duration::from_millis(1500);
01:04:15 out   #[derive(Clone, Debug, Default)]
01:04:15 out   pub struct Snapshot {
01:04:15 out   pub connected: bool,
01:04:15 out   pub position: Option<f64>,
01:04:15 out   /// True while the timecode has changed recently, i.e. Audacity is running.
01:04:15 out   pub moving: bool,
01:04:15 out   /// True when Audacity's timecode display uses the requested
01:04:15 out   /// `00h00m00.000s` style rather than a bare colon clock.
01:04:15 out   pub format_ok: bool,
01:04:15 out   pub message: String,
01:04:15 out   }
01:04:15 out   struct TimecodeNode {
01:04:15 out   conn: Connection,
01:04:15 out   bus: String,
01:04:15 out   path: String,
01:04:15 out   }
01:04:15 out   impl TimecodeNode {
01:04:15 out   fn read(&self) -> Result<String, Box<dyn Error>> {
01:04:15 out   let props = Proxy::new(
01:04:15 out   &self.conn,
01:04:15 out   self.bus.as_str(),
01:04:15 out   self.path.as_str(),
01:04:15 out   "org.freedesktop.DBus.Properties",
01:04:15 out   )?;
01:04:15 out   let value: OwnedValue = props.call("Get", &("org.a11y.atspi.Accessible", "Name"))?;
01:04:15 out   Ok(String::try_from(value)?)
01:04:15 out   }
01:04:15 out   }
01:04:15 out   pub struct AudacityLink {
01:04:15 out   state: Arc<Mutex<Snapshot>>,
01:04:15 out   stop: Arc<AtomicBool>,
01:04:15 out   }
01:04:15 out   impl AudacityLink {
01:04:15 out   pub fn new() -> Self {
01:04:15 out   let state = Arc::new(Mutex::new(Snapshot {
01:04:15 out   connected: false,
01:04:15 out   position: None,
01:04:15 out   moving: false,
01:04:15 out   format_ok: false,
01:04:15 out   message: "looking for Audacity…".to_string(),
01:04:15 out   }));
01:04:15 out   let stop = Arc::new(AtomicBool::new(false));
01:04:15 out   let worker_state = Arc::clone(&state);
01:04:15 out   let worker_stop = Arc::clone(&stop);
01:04:15 out   thread::spawn(move || poll_loop(worker_state, worker_stop));
01:04:15 out   AudacityLink { state, stop }
01:04:15 out   }
01:04:15 out   pub fn snapshot(&self) -> Snapshot {
01:04:15 out   self.state.lock().map(|s| s.clone()).unwrap_or_default()
01:04:15 out   }
01:04:15 out   }
01:04:15 out   impl Drop for AudacityLink {
