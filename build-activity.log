02:38:14 out   let d = measure_text(s, Some(font), size, 1.0);
02:38:14 out   text_left(font, s, cx - d.width / 2.0, y, size, color);
02:38:14 out   }
02:38:14 out   pub fn text_right(font: &Font, s: &str, rx: f32, y: f32, size: u16, color: Color) {
02:38:14 out   let d = measure_text(s, Some(font), size, 1.0);
02:38:14 out   text_left(font, s, rx - d.width, y, size, color);
02:38:14 out   }
02:38:14 out   /// Draw text centred inside a rectangle.
02:38:14 out   pub fn text_in_rect(font: &Font, s: &str, r: Rect, size: u16, color: Color) {
02:38:14 out   let d = measure_text(s, Some(font), size, 1.0);
02:38:14 out   let x = r.x + (r.w - d.width) / 2.0;
02:38:14 out   let top = r.y + (r.h - d.height) / 2.0;
02:38:14 out   text_left(font, s, x, top, size, color);
02:38:14 out   }
02:38:14 out   pub fn text_width(font: &Font, s: &str, size: u16) -> f32 {
02:38:14 out   measure_text(s, Some(font), size, 1.0).width
02:38:14 out   }
02:38:14 out   /// Shorten a string with an ellipsis so that it fits in max_w.
02:38:14 out   pub fn ellipsize(font: &Font, s: &str, size: u16, max_w: f32) -> String {
02:38:14 out   if text_width(font, s, size) <= max_w {
02:38:14 out   return s.to_string();
02:38:14 out   }
02:38:14 out   let ell = "…";
02:38:14 out   let ell_w = text_width(font, ell, size);
02:38:14 out   let mut out = String::new();
02:38:14 out   for ch in s.chars() {
02:38:14 out   let mut candidate = out.clone();
02:38:14 out   candidate.push(ch);
02:38:14 out   if text_width(font, &candidate, size) + ell_w > max_w {
02:38:14 out   break;
02:38:14 out   }
02:38:14 out   out = candidate;
02:38:14 out   }
02:38:14 out   out.push('…');
02:38:14 out   out
02:38:14 out   }
