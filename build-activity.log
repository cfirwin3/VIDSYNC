01:00:22 out   connected: false,
01:00:22 out   position: None,
01:00:22 out   moving: false,
01:00:22 out   format_ok: false,
01:00:22 out   message: "looking for Audacity…".to_string(),
01:00:22 out   }));
01:00:22 out   let stop = Arc::new(AtomicBool::new(false));
01:00:22 out   let worker_state = Arc::clone(&state);
01:00:22 out   let worker_stop = Arc::clone(&stop);
01:00:22 out   thread::spawn(move || poll_loop(worker_state, worker_stop));
