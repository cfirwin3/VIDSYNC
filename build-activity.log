01:00:22 out   Ok(String::try_from(value)?)
01:00:22 out   }
01:00:22 out   }
01:00:22 out   pub struct AudacityLink {
01:00:22 out   state: Arc<Mutex<Snapshot>>,
01:00:22 out   stop: Arc<AtomicBool>,
01:00:22 out   }
01:00:22 out   impl AudacityLink {
01:00:22 out   pub fn new() -> Self {
