14:44:47 out   #!/usr/bin/env python3
14:44:47 out   """Draw the VidCue app icon.
14:44:47 out   The icon mirrors the small logo shown to the left of the VIDCUE wordmark: a
14:44:47 out   soft purple rounded square with a bright purple play triangle. Run from the app
14:44:47 out   folder with ``python3 scripts/make-icon.py``; Pillow is required.
14:44:47 out   """
14:44:47 out   from pathlib import Path
14:44:47 out   from PIL import Image, ImageDraw
14:44:47 out   ROOT = Path(__file__).resolve().parent.parent
14:44:47 out   OUT = ROOT / "assets" / "vidcue.png"
14:44:47 out   # Colours sampled from the in-app logo (purple accent over the dark header).
14:44:47 out   SOFT_PURPLE = (37, 30, 52, 255)
14:44:47 out   PLAY_PURPLE = (176, 122, 239, 255)
14:44:47 out   def build(size: int) -> Image.Image:
14:44:47 out   s = size / 512.0
14:44:47 out   def r(*values):
14:44:47 out   return tuple(round(v * s) for v in values)
14:44:47 out   img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
14:44:47 out   d = ImageDraw.Draw(img)
14:44:47 out   # The rounded tile and the play mark keep the same proportions as the
14:44:47 out   # in-app logo (radius 30% of the tile, triangle 44% high).
14:44:47 out   d.rounded_rectangle(r(12, 12, 500, 500), radius=r(146)[0], fill=SOFT_PURPLE)
14:44:47 out   d.polygon(
14:44:47 out   [r(202, 161), r(202, 375), r(379, 268)],
14:44:47 out   fill=PLAY_PURPLE,
14:44:47 out   )
14:44:47 out   return img
14:44:47 out   def main() -> None:
14:44:47 out   OUT.parent.mkdir(parents=True, exist_ok=True)
14:44:47 out   build(512).resize((256, 256), Image.LANCZOS).save(OUT)
14:44:47 out   print(f"wrote {OUT}")
14:44:47 out   if __name__ == "__main__":
14:44:47 out   main()
