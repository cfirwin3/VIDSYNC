16:04:47 out   pub fn fmt_time(seconds: f64, millis: bool) -> String {
16:04:47 out   let t = seconds.max(0.0);
16:04:47 out   let total_ms = (t * 1000.0).round() as u64;
16:04:47 out   let ms = total_ms % 1000;
16:04:47 out   let total = total_ms / 1000;
16:04:47 out   let h = total / 3600;
16:04:47 out   let m = (total % 3600) / 60;
16:04:47 out   let s = total % 60;
16:04:47 out   if millis {
16:04:47 out   format!("{:02}:{:02}:{:02}.{:03}", h, m, s, ms)
16:04:47 out   } else {
16:04:47 out   format!("{:02}:{:02}:{:02}", h, m, s)
16:04:47 out   }
16:04:47 out   }
16:04:47 out   /// Parse hours:minutes:seconds, minutes:seconds, or plain seconds.
16:04:47 out   /// Fractional seconds are accepted.
16:04:47 out   pub fn parse_time(input: &str) -> Option<f64> {
16:04:47 out   let s = input.trim();
16:04:47 out   if s.is_empty() {
16:04:47 out   return None;
16:04:47 out   }
16:04:47 out   let parts: Vec<&str> = s.split(':').collect();
16:04:47 out   if parts.len() > 3 {
16:04:47 out   return None;
16:04:47 out   }
16:04:47 out   let mut total = 0.0;
16:04:47 out   for (i, raw) in parts.iter().enumerate() {
16:04:47 out   let raw = raw.trim();
16:04:47 out   if raw.is_empty() {
16:04:47 out   return None;
16:04:47 out   }
16:04:47 out   let value: f64 = raw.parse().ok()?;
16:04:47 out   if !value.is_finite() || value < 0.0 {
16:04:47 out   return None;
16:04:47 out   }
16:04:47 out   let multiplier = match parts.len() - i {
16:04:47 out   1 => 1.0,
16:04:47 out   2 => 60.0,
16:04:47 out   3 => 3600.0,
16:04:47 out   _ => return None,
16:04:47 out   };
16:04:47 out   total += value * multiplier;
16:04:47 out   }
16:04:47 out   if total.is_finite() {
16:04:47 out   Some(total)
16:04:47 out   } else {
16:04:47 out   None
16:04:47 out   }
16:04:47 out   }
