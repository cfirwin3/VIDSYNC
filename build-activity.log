23:31:26 out   DARK = (20, 17, 12, 255)
23:31:26 out   def build(size: int) -> Image.Image:
23:31:26 out   s = size / 512.0
23:31:26 out   def r(*values):
23:31:26 out   return tuple(round(v * s) for v in values)
23:31:26 out   img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
23:31:26 out   d = ImageDraw.Draw(img)
23:31:26 out   d.rounded_rectangle(r(12, 12, 500, 500), radius=r(112)[0], fill=BG,
23:31:26 out   outline=AMBER, width=max(1, r(9)[0]))
