17:36:04 out   fn count_pixels<F>(img: &Image, rect: Rect, scale: f32, f: F) -> usize
17:36:04 out   where
17:36:04 out   F: Fn(u8, u8, u8) -> bool,
17:36:04 out   {
17:36:04 out   let iw = img.width as usize;
17:36:04 out   let ih = img.height as usize;
17:36:04 out   if iw == 0 || ih == 0 {
17:36:04 out   return 0;
17:36:04 out   }
17:36:04 out   let x0 = (rect.x * scale).max(0.0) as usize;
17:36:04 out   let x1 = ((rect.x + rect.w) * scale).min(iw as f32) as usize;
17:36:04 out   let y0 = (rect.y * scale).max(0.0) as usize;
17:36:04 out   let y1 = ((rect.y + rect.h) * scale).min(ih as f32) as usize;
17:36:04 out   let mut count = 0;
17:36:04 out   for sy in y0..y1 {
17:36:04 out   let iy = ih - 1 - sy;
17:36:04 out   for x in x0..x1 {
17:36:04 out   let idx = (iy * iw + x) * 4;
17:36:04 out   if idx + 3 < img.bytes.len()
17:36:04 out   && f(img.bytes[idx], img.bytes[idx + 1], img.bytes[idx + 2])
17:36:04 out   {
17:36:04 out   count += 1;
17:36:04 out   }
17:36:04 out   }
17:36:04 out   }
17:36:04 out   count
17:36:04 out   }
