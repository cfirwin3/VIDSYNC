02:09:06 out   #!/usr/bin/env python3
02:09:06 out   """Draw the VIDSYNC app icon.
02:09:06 out   The icon mirrors the small logo shown to the left of the VIDSYNC wordmark: a
02:09:06 out   soft purple rounded square with a bright purple play triangle. Run from the app
02:09:06 out   folder with ``python3 scripts/make-icon.py``; Pillow is required.
02:09:06 out   """
02:09:06 out   from pathlib import Path
02:09:06 out   from PIL import Image, ImageDraw
02:09:06 out   ROOT = Path(__file__).resolve().parent.parent
02:09:06 out   OUT = ROOT / "assets" / "vidsync.png"
02:09:06 out   # Colours sampled from the in-app logo (purple accent over the dark header).
02:09:06 out   SOFT_PURPLE = (37, 30, 52, 255)
02:09:06 out   PLAY_PURPLE = (176, 122, 239, 255)
02:09:06 out   def build(size: int) -> Image.Image:
02:09:06 out   s = size / 512.0
02:09:06 out   def r(*values):
02:09:06 out   return tuple(round(v * s) for v in values)
02:09:06 out   img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
02:09:06 out   d = ImageDraw.Draw(img)
02:09:06 out   # The rounded tile and the play mark keep the same proportions as the
02:09:06 out   # in-app logo (radius 30% of the tile, triangle 44% high).
02:09:06 out   d.rounded_rectangle(r(12, 12, 500, 500), radius=r(146)[0], fill=SOFT_PURPLE)
02:09:06 out   d.polygon(
02:09:06 out   [r(202, 161), r(202, 375), r(379, 268)],
02:09:06 out   fill=PLAY_PURPLE,
02:09:06 out   )
02:09:06 out   return img
02:09:06 out   def main() -> None:
02:09:06 out   OUT.parent.mkdir(parents=True, exist_ok=True)
02:09:06 out   build(512).resize((256, 256), Image.LANCZOS).save(OUT)
02:09:06 out   print(f"wrote {OUT}")
02:09:06 out   if __name__ == "__main__":
02:09:06 out   main()
