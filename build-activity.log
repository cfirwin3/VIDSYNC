16:04:47 out   /// A small gear: eight teeth around a ring with a hollow centre.
16:04:47 out   pub fn gear_icon(cx: f32, cy: f32, r: f32, color: Color) {
16:04:47 out   let tooth = (r * 0.28).max(1.4);
16:04:47 out   for i in 0..8 {
16:04:47 out   let a = i as f32 * std::f32::consts::TAU / 8.0;
16:04:47 out   let inner = r * 0.62;
16:04:47 out   let outer = r;
16:04:47 out   draw_line(
16:04:47 out   cx + a.cos() * inner,
16:04:47 out   cy + a.sin() * inner,
16:04:47 out   cx + a.cos() * outer,
16:04:47 out   cy + a.sin() * outer,
16:04:47 out   tooth,
16:04:47 out   color,
16:04:47 out   );
16:04:47 out   }
16:04:47 out   draw_circle_lines(cx, cy, r * 0.55, (r * 0.22).max(1.0), color);
16:04:47 out   draw_circle(cx, cy, r * 0.17, color);
16:04:47 out   }
