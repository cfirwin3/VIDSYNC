17:36:07 out   pub moving: bool,
17:36:07 out   /// True when Audacity's timecode display uses the requested
17:36:07 out   /// `00h00m00.000s` style rather than a bare colon clock.
17:36:07 out   pub format_ok: bool,
17:36:07 out   pub message: String,
17:36:07 out   }
