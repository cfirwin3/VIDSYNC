16:02:55 out   async fn run_self_test(app: &mut App, out: &Path) {
16:02:55 out   let mut results: Vec<(String, bool, String)> = Vec::new();
16:02:55 out   app.sync.enabled = false;
16:02:55 out   let sample = ensure_sample();
16:02:55 out   app.load_media(sample);
16:02:55 out   // Wait until the first frame is on screen.
16:02:55 out   let mut frame_ok = false;
16:02:55 out   for _ in 0..180 {
16:02:55 out   app.tick(1.0 / 60.0);
16:02:55 out   app.draw();
16:02:55 out   if app.player.has_frame {
16:02:55 out   frame_ok = true;
16:02:55 out   break;
16:02:55 out   }
16:02:55 out   next_frame().await;
16:02:55 out   }
16:02:55 out   // move: playback advances.
16:02:55 out   app.action_play();
16:02:55 out   let start_pos = app.player.position;
16:02:55 out   for _ in 0..90 {
16:02:55 out   app.tick(1.0 / 60.0);
16:02:55 out   app.draw();
16:02:55 out   next_frame().await;
16:02:55 out   }
16:02:55 out   let moved = app.player.position - start_pos;
16:02:55 out   results.push((
16:02:55 out   "move".to_string(),
16:02:55 out   frame_ok && moved > 1.0,
16:02:55 out   format!(
16:02:55 out   "video playback advanced {:.2} s and frames are visible",
16:02:55 out   moved
16:02:55 out   ),
16:02:55 out   ));
16:02:55 out   // act: stop, typed cue point, and resume.
16:02:55 out   app.action_stop();
16:02:55 out   let rewound = (app.player.position - app.start_marker).abs() < 0.05;
16:02:55 out   app.field.focus();
16:02:55 out   for ch in "00:00:04.000".chars() {
16:02:55 out   app.field.type_char(ch);
16:02:55 out   }
16:02:55 out   let typed = app.field.press_enter();
16:02:55 out   if let Some(v) = typed {
16:02:55 out   app.apply_start(v);
16:02:55 out   }
16:02:55 out   let applied = (app.start_marker - 4.0).abs() < 0.06 && (app.player.position - 4.0).abs() < 0.12;
16:02:55 out   app.action_play();
16:02:55 out   let p0 = app.player.position;
16:02:55 out   for _ in 0..45 {
16:02:55 out   app.tick(1.0 / 60.0);
16:02:55 out   app.draw();
16:02:55 out   next_frame().await;
16:02:55 out   }
16:02:55 out   let advanced = app.player.position - p0;
16:02:55 out   app.action_stop();
16:02:55 out   let millis_shown = app.field.text == "00:00:04.000";
16:02:55 out   results.push((
16:02:55 out   "act".to_string(),
16:02:55 out   rewound && applied && millis_shown && advanced > 0.4,
16:02:55 out   format!(
16:02:55 out   "typed start 00:00:04.000 applied; playback resumed and advanced {:.2} s",
16:02:55 out   advanced
16:02:55 out   ),
16:02:55 out   ));
16:02:55 out   // hud: transport clock and start field are really painted.
16:02:55 out   app.tick(1.0 / 60.0);
16:02:55 out   app.draw();
16:02:55 out   let img = get_screen_data();
16:02:55 out   let l = Layout::new(screen_width(), screen_height(), true);
16:02:55 out   let scale = img.width as f32 / screen_width();
16:02:55 out   let clock_px = count_pixels(&img, l.time_area, scale, |r, g, b| {
16:02:55 out   r > 150 && g > 140 && b > 130
16:02:55 out   });
16:02:55 out   let field_px = count_pixels(&img, l.field, scale, |r, g, b| r > 90 && g > 70 && b > 40);
16:02:55 out   results.push((
16:02:55 out   "hud".to_string(),
16:02:55 out   clock_px > 100 && field_px > 100,
16:02:55 out   format!("transport clock ({clock_px} px) and start-time field ({field_px} px) are drawn"),
16:02:55 out   ));
16:02:55 out   let steps: Vec<serde_json::Value> = results
16:02:55 out   .iter()
16:02:55 out   .map(|(step, passed, detail)| {
16:02:55 out   serde_json::json!({
16:02:55 out   "step": step,
16:02:55 out   "passed": passed,
16:02:55 out   "detail": detail,
16:02:55 out   })
16:02:55 out   })
16:02:55 out   .collect();
16:02:55 out   let json = serde_json::json!({
16:02:55 out   "version": 1,
16:02:55 out   "steps": steps,
16:02:55 out   });
16:02:55 out   if let Some(parent) = out.parent() {
16:02:55 out   let _ = fs::create_dir_all(parent);
16:02:55 out   }
16:02:55 out   let _ = fs::write(out, serde_json::to_string_pretty(&json).unwrap_or_default());
16:02:55 out   next_frame().await;
16:02:55 out   }
16:02:55 out   fn count_pixels<F>(img: &Image, rect: Rect, scale: f32, f: F) -> usize
16:02:55 out   where
16:02:55 out   F: Fn(u8, u8, u8) -> bool,
16:02:55 out   {
16:02:55 out   let iw = img.width as usize;
16:02:55 out   let ih = img.height as usize;
16:02:55 out   if iw == 0 || ih == 0 {
16:02:55 out   return 0;
16:02:55 out   }
16:02:55 out   let x0 = (rect.x * scale).max(0.0) as usize;
16:02:55 out   let x1 = ((rect.x + rect.w) * scale).min(iw as f32) as usize;
16:02:55 out   let y0 = (rect.y * scale).max(0.0) as usize;
16:02:55 out   let y1 = ((rect.y + rect.h) * scale).min(ih as f32) as usize;
16:02:55 out   let mut count = 0;
16:02:55 out   for sy in y0..y1 {
16:02:55 out   let iy = ih - 1 - sy;
16:02:55 out   for x in x0..x1 {
16:02:55 out   let idx = (iy * iw + x) * 4;
16:02:55 out   if idx + 3 < img.bytes.len()
16:02:55 out   && f(img.bytes[idx], img.bytes[idx + 1], img.bytes[idx + 2])
16:02:55 out   {
16:02:55 out   count += 1;
16:02:55 out   }
16:02:55 out   }
16:02:55 out   }
16:02:55 out   count
16:02:55 out   }
