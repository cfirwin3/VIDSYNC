01:39:10 out   #!/usr/bin/env bash
01:39:10 out   # Build a self-contained VidCue AppImage.
01:39:10 out   #
01:39:10 out   # ./scripts/build-appimage.sh
01:39:10 out   #
01:39:10 out   # It downloads a static ffmpeg/ffprobe build and appimagetool into build/cache
01:39:10 out   # the first time, stages build/VidCue.AppDir, and writes dist/*.AppImage.
01:39:10 out   # No FUSE is needed: the tool is run with APPIMAGE_EXTRACT_AND_RUN=1.
01:39:10 out   set -euo pipefail
01:39:10 out   ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
01:39:10 out   cd "$ROOT"
01:39:10 out   APP="VidCue"
01:39:10 out   ARCH="${ARCH:-x86_64}"
01:39:10 out   VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
01:39:10 out   if [ -z "$VERSION" ]; then
01:39:10 out   echo "Could not read the version from Cargo.toml" >&2
01:39:10 out   exit 1
01:39:10 out   fi
01:39:10 out   case "$ARCH" in
01:39:10 out   x86_64)
01:39:10 out   FFMPEG_URL="https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
01:39:10 out   APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
01:39:10 out   ;;
01:39:10 out   *)
01:39:10 out   echo "Only x86_64 AppImages are supported by this script (got ARCH=$ARCH)." >&2
01:39:10 out   echo "Set ARCH=x86_64 or adapt the download URLs." >&2
01:39:10 out   exit 1
01:39:10 out   ;;
01:39:10 out   esac
01:39:10 out   BUILD="$ROOT/build"
01:39:10 out   CACHE="$BUILD/cache"
01:39:10 out   APPDIR="$BUILD/$APP.AppDir"
01:39:10 out   DIST="$ROOT/dist"
01:39:10 out   BIN="$ROOT/target/release/cue-video-player"
01:39:10 out   FF_DIR="$CACHE/ffmpeg-static"
01:39:10 out   FF_ARCHIVE="$CACHE/ffmpeg-static.tar.xz"
01:39:10 out   APPIMAGETOOL="$CACHE/appimagetool-$ARCH.AppImage"
01:39:10 out   OUT="$DIST/$APP-$VERSION-$ARCH.AppImage"
01:39:10 out   need() {
01:39:10 out   command -v "$1" >/dev/null 2>&1 || {
01:39:10 out   echo "Missing required command: $1" >&2
01:39:10 out   exit 1
01:39:10 out   }
01:39:10 out   }
01:39:10 out   need cargo
01:39:10 out   need curl
01:39:10 out   need tar
01:39:10 out   need xz
01:39:10 out   echo "==> Building release binary"
01:39:10 out   cargo build --release --locked
01:39:10 out   echo "==> Preparing build folders"
01:39:10 out   mkdir -p "$CACHE" "$DIST"
01:39:10 out   rm -rf "$APPDIR"
01:39:10 out   mkdir -p "$APPDIR/usr/bin" \
01:39:10 out   "$APPDIR/usr/share/applications" \
01:39:10 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps" \
01:39:10 out   "$APPDIR/usr/share/doc/vidcue"
01:39:10 out   echo "==> Fetching static ffmpeg and ffprobe (cached)"
01:39:10 out   if [ ! -x "$FF_DIR/ffmpeg" ] || [ ! -x "$FF_DIR/ffprobe" ]; then
01:39:10 out   if [ ! -f "$FF_ARCHIVE" ]; then
01:39:10 out   curl -fL --retry 3 --retry-delay 2 -o "$FF_ARCHIVE" "$FFMPEG_URL"
01:39:10 out   fi
01:39:10 out   rm -rf "$FF_DIR"
01:39:10 out   mkdir -p "$FF_DIR"
01:39:10 out   tar -xJf "$FF_ARCHIVE" -C "$FF_DIR" --strip-components=1
01:39:10 out   fi
01:39:10 out   echo "==> Fetching appimagetool (cached)"
01:39:10 out   if [ ! -x "$APPIMAGETOOL" ]; then
01:39:10 out   if [ ! -f "$APPIMAGETOOL" ]; then
01:39:10 out   curl -fL --retry 3 --retry-delay 2 -o "$APPIMAGETOOL" "$APPIMAGETOOL_URL"
01:39:10 out   fi
01:39:10 out   chmod +x "$APPIMAGETOOL"
01:39:10 out   fi
01:39:10 out   echo "==> Staging AppDir"
01:39:10 out   install -Dm755 "$BIN" "$APPDIR/usr/bin/vidcue"
01:39:10 out   install -Dm755 "$FF_DIR/ffmpeg" "$APPDIR/usr/bin/ffmpeg"
01:39:10 out   install -Dm755 "$FF_DIR/ffprobe" "$APPDIR/usr/bin/ffprobe"
01:39:10 out   install -Dm644 "$ROOT/assets/vidcue.png" \
01:39:10 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png"
01:39:10 out   install -Dm644 "$ROOT/scripts/vidcue.desktop" \
01:39:10 out   "$APPDIR/usr/share/applications/vidcue.desktop"
01:39:10 out   install -Dm644 "$ROOT/README.md" "$APPDIR/usr/share/doc/vidcue/README.md"
01:39:10 out   install -Dm644 "$ROOT/MECHANICS.md" "$APPDIR/usr/share/doc/vidcue/MECHANICS.md"
01:39:10 out   install -Dm644 "$ROOT/LICENSE" "$APPDIR/usr/share/doc/vidcue/LICENSE"
01:39:10 out   install -Dm644 "$ROOT/assets/fonts/LICENSE-DejaVu.txt" \
01:39:10 out   "$APPDIR/usr/share/doc/vidcue/LICENSE-DejaVu.txt"
01:39:10 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png" "$APPDIR/vidcue.png"
01:39:10 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png" "$APPDIR/.DirIcon"
01:39:10 out   cp "$APPDIR/usr/share/applications/vidcue.desktop" "$APPDIR/vidcue.desktop"
01:39:10 out   cat > "$APPDIR/AppRun" <<'APPRUN'
01:39:10 out   #!/bin/sh
01:39:10 out   # AppRun for VidCue. Keep ffmpeg and ffprobe next to the binary.
01:39:10 out   set -eu
01:39:10 out   HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
01:39:10 out   export APPDIR="$HERE"
01:39:10 out   export PATH="$HERE/usr/bin:${PATH:-/usr/bin:/bin}"
01:39:10 out   exec "$HERE/usr/bin/vidcue" "$@"
01:39:10 out   APPRUN
01:39:10 out   chmod +x "$APPDIR/AppRun"
01:39:10 out   if command -v desktop-file-validate >/dev/null 2>&1; then
01:39:10 out   desktop-file-validate "$APPDIR/usr/share/applications/vidcue.desktop" || true
01:39:10 out   fi
01:39:10 out   echo "==> Packing AppImage"
01:39:10 out   rm -f "$OUT"
01:39:10 out   APPIMAGE_EXTRACT_AND_RUN=1 ARCH="$ARCH" \
01:39:10 out   "$APPIMAGETOOL" --no-appstream "$APPDIR" "$OUT"
01:39:10 out   chmod +x "$OUT"
01:39:10 out   echo
01:39:10 out   echo "Built $OUT"
01:39:10 out   ls -lh "$OUT"
01:39:10 out   ---DESKTOP---
01:39:10 out   [Desktop Entry]
01:39:10 out   Type=Application
01:39:10 out   Name=VIDCUE
01:39:10 out   GenericName=Video Player
01:39:10 out   Comment=Video-only player that follows Audacity 4.0's timecode
01:39:10 out   Exec=vidcue %f
01:39:10 out   TryExec=vidcue
01:39:10 out   Icon=vidcue
01:39:10 out   Terminal=false
01:39:10 out   Categories=AudioVideo;Video;Player;
01:39:10 out   MimeType=video/mp4;video/x-matroska;video/quicktime;video/webm;video/x-msvideo;video/mpeg;video/mp2t;video/ogg;video/x-flv;video/x-ms-wmv;
01:39:10 out   StartupWMClass=vidcue
01:39:10 out   Keywords=video;player;audacity;cue;foley;audition;
01:39:10 out   ---MAKEICON---
01:39:10 out   #!/usr/bin/env python3
01:39:10 out   """Draw the VidCue app icon.
01:39:10 out   The icon mirrors the small logo shown to the left of the VIDCUE wordmark: a
01:39:10 out   soft purple rounded square with a bright purple play triangle. Run from the app
01:39:10 out   folder with ``python3 scripts/make-icon.py``; Pillow is required.
01:39:10 out   """
01:39:10 out   from pathlib import Path
01:39:10 out   from PIL import Image, ImageDraw
01:39:10 out   ROOT = Path(__file__).resolve().parent.parent
01:39:10 out   OUT = ROOT / "assets" / "vidcue.png"
01:39:10 out   # Colours sampled from the in-app logo (purple accent over the dark header).
01:39:10 out   SOFT_PURPLE = (37, 30, 52, 255)
01:39:10 out   PLAY_PURPLE = (176, 122, 239, 255)
01:39:10 out   def build(size: int) -> Image.Image:
01:39:10 out   s = size / 512.0
01:39:10 out   def r(*values):
01:39:10 out   return tuple(round(v * s) for v in values)
01:39:10 out   img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
01:39:10 out   d = ImageDraw.Draw(img)
01:39:10 out   # The rounded tile and the play mark keep the same proportions as the
01:39:10 out   # in-app logo (radius 30% of the tile, triangle 44% high).
01:39:10 out   d.rounded_rectangle(r(12, 12, 500, 500), radius=r(146)[0], fill=SOFT_PURPLE)
01:39:10 out   d.polygon(
01:39:10 out   [r(202, 161), r(202, 375), r(379, 268)],
01:39:10 out   fill=PLAY_PURPLE,
01:39:10 out   )
01:39:10 out   return img
01:39:10 out   def main() -> None:
01:39:10 out   OUT.parent.mkdir(parents=True, exist_ok=True)
01:39:10 out   build(512).resize((256, 256), Image.LANCZOS).save(OUT)
01:39:10 out   print(f"wrote {OUT}")
01:39:10 out   if __name__ == "__main__":
01:39:10 out   main()
