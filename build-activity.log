14:38:39 out   /// Draw text centred inside a rectangle.
14:38:39 out   pub fn text_in_rect(font: &Font, s: &str, r: Rect, size: u16, color: Color) {
14:38:39 out   let d = measure_text(s, Some(font), size, 1.0);
14:38:39 out   let x = r.x + (r.w - d.width) / 2.0;
14:38:39 out   let top = r.y + (r.h - d.height) / 2.0;
14:38:39 out   text_left(font, s, x, top, size, color);
14:38:39 out   }
14:38:39 out   pub fn text_width(font: &Font, s: &str, size: u16) -> f32 {
14:38:39 out   measure_text(s, Some(font), size, 1.0).width
14:38:39 out   }
14:38:39 out   /// Shorten a string with an ellipsis so that it fits in max_w.
14:38:39 out   pub fn ellipsize(font: &Font, s: &str, size: u16, max_w: f32) -> String {
14:38:39 out   if text_width(font, s, size) <= max_w {
14:38:39 out   return s.to_string();
14:38:39 out   }
14:38:39 out   let ell = "…";
14:38:39 out   let ell_w = text_width(font, ell, size);
14:38:39 out   let mut out = String::new();
14:38:39 out   for ch in s.chars() {
14:38:39 out   let mut candidate = out.clone();
14:38:39 out   candidate.push(ch);
14:38:39 out   if text_width(font, &candidate, size) + ell_w > max_w {
14:38:39 out   break;
14:38:39 out   }
14:38:39 out   out = candidate;
14:38:39 out   }
14:38:39 out   out.push('…');
14:38:39 out   out
14:38:39 out   }
