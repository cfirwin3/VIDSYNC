17:36:40 out   /// Parse the text Audacity exposes for its playback position.
17:36:40 out   ///
17:36:40 out   /// The display can be `00h00m00.000s`, `00 h 00 m 11.037 s`, or a colon clock
17:36:40 out   /// such as `00:00:11.037`; all describe the same hours:minutes:seconds.mmm
17:36:40 out   /// value. The readable prefix is removed before the number is read.
17:36:40 out   pub fn parse_timecode(raw: &str) -> Option<f64> {
17:36:40 out   let mut text = raw.trim();
17:36:40 out   let first_lower = text.to_ascii_lowercase();
17:36:40 out   if first_lower.contains('h') && first_lower.contains('m') && first_lower.contains('s') {
17:36:40 out   // An accessible name may be labelled (`Playback position:` in any
17:36:40 out   // language) and may use spaces around the units. Remove the label and
17:36:40 out   // anything before the first digit, but never touch a colon clock such
17:36:40 out   // as `00:00:11.037`.
17:36:40 out   if let Some((prefix, rest)) = text.split_once(':') {
17:36:40 out   let prefix = prefix.to_ascii_lowercase();
17:36:40 out   let rest_lower = rest.to_ascii_lowercase();
17:36:40 out   if prefix.contains("position")
17:36:40 out   || prefix.contains("timecode")
17:36:40 out   || (rest_lower.contains('h')
17:36:40 out   && rest_lower.contains('m')
17:36:40 out   && rest_lower.contains('s'))
17:36:40 out   {
17:36:40 out   text = rest;
17:36:40 out   }
17:36:40 out   }
17:36:40 out   if !text.starts_with(|c: char| c.is_ascii_digit()) {
17:36:40 out   if let Some(index) = text.find(|c: char| c.is_ascii_digit()) {
17:36:40 out   text = &text[index..];
17:36:40 out   }
17:36:40 out   }
17:36:40 out   }
17:36:40 out   let lower = text.to_ascii_lowercase();
17:36:40 out   if lower.contains('h') || lower.contains('m') || lower.contains('s') {
17:36:40 out   let mut total = 0.0;
17:36:40 out   let mut start = 0usize;
17:36:40 out   let mut parts = 0;
17:36:40 out   let mut seconds = 0.0;
17:36:40 out   for (i, ch) in lower.char_indices() {
17:36:40 out   let unit = match ch {
17:36:40 out   'h' => 'h',
17:36:40 out   'm' => 'm',
17:36:40 out   's' => 's',
17:36:40 out   _ => continue,
17:36:40 out   };
17:36:40 out   let number: f64 = text[start..i].trim().parse().ok()?;
17:36:40 out   if !number.is_finite() || number < 0.0 {
17:36:40 out   return None;
17:36:40 out   }
17:36:40 out   match unit {
17:36:40 out   'h' => total += number * 3600.0,
17:36:40 out   'm' => total += number * 60.0,
17:36:40 out   's' => seconds = number,
17:36:40 out   _ => {}
17:36:40 out   }
17:36:40 out   parts += 1;
17:36:40 out   start = i + ch.len_utf8();
17:36:40 out   }
17:36:40 out   if parts == 0 {
17:36:40 out   return None;
17:36:40 out   }
17:36:40 out   total += seconds;
17:36:40 out   return Some(total.max(0.0));
17:36:40 out   }
17:36:40 out   // Fall back to the colon clock used by the rest of the interface.
17:36:40 out   parse_clock(text)
17:36:40 out   }
17:36:40 out   fn parse_clock(text: &str) -> Option<f64> {
17:36:40 out   let text = text.trim();
17:36:40 out   if text.is_empty() {
17:36:40 out   return None;
17:36:40 out   }
17:36:40 out   let parts: Vec<&str> = text.split(':').collect();
17:36:40 out   if parts.len() > 3 {
17:36:40 out   return None;
17:36:40 out   }
17:36:40 out   let mut total = 0.0;
17:36:40 out   for (i, raw) in parts.iter().enumerate() {
17:36:40 out   let value: f64 = raw.trim().parse().ok()?;
17:36:40 out   if !value.is_finite() || value < 0.0 {
17:36:40 out   return None;
17:36:40 out   }
17:36:40 out   total += value
17:36:40 out   * match parts.len() - i {
17:36:40 out   1 => 1.0,
17:36:40 out   2 => 60.0,
17:36:40 out   3 => 3600.0,
17:36:40 out   _ => return None,
17:36:40 out   };
17:36:40 out   }
17:36:40 out   if total.is_finite() {
17:36:40 out   Some(total)
17:36:40 out   } else {
17:36:40 out   None
17:36:40 out   }
17:36:40 out   }
