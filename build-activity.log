16:08:00 out   if [ -z "$VERSION" ]; then
16:08:00 out   echo "Could not read the version from Cargo.toml" >&2
16:08:00 out   exit 1
16:08:00 out   fi
16:08:00 out   case "$ARCH" in
16:08:00 out   x86_64)
16:08:00 out   FFMPEG_URL="https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
16:08:00 out   APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
16:08:00 out   ;;
16:08:00 out   *)
16:08:00 out   echo "Only x86_64 AppImages are supported by this script (got ARCH=$ARCH)." >&2
16:08:00 out   echo "Set ARCH=x86_64 or adapt the download URLs." >&2
16:08:00 out   exit 1
16:08:00 out   ;;
16:08:00 out   esac
16:08:00 out   BUILD="$ROOT/build"
16:08:00 out   CACHE="$BUILD/cache"
16:08:00 out   APPDIR="$BUILD/$APP.AppDir"
16:08:00 out   DIST="$ROOT/dist"
16:08:00 out   BIN="$ROOT/target/release/cue-video-player"
16:08:00 out   FF_DIR="$CACHE/ffmpeg-static"
16:08:00 out   FF_ARCHIVE="$CACHE/ffmpeg-static.tar.xz"
16:08:00 out   APPIMAGETOOL="$CACHE/appimagetool-$ARCH.AppImage"
16:08:00 out   OUT="$DIST/$APP-$VERSION-$ARCH.AppImage"
16:08:00 out   need() {
16:08:00 out   command -v "$1" >/dev/null 2>&1 || {
16:08:00 out   echo "Missing required command: $1" >&2
16:08:00 out   exit 1
16:08:00 out   }
16:08:00 out   }
16:08:00 out   need cargo
16:08:00 out   need curl
16:08:00 out   need tar
16:08:00 out   need xz
16:08:00 out   echo "==> Building release binary"
16:08:00 out   cargo build --release --locked
16:08:00 out   echo "==> Preparing build folders"
16:08:00 out   mkdir -p "$CACHE" "$DIST"
16:08:00 out   rm -rf "$APPDIR"
16:08:00 out   mkdir -p "$APPDIR/usr/bin" \
16:08:00 out   "$APPDIR/usr/share/applications" \
16:08:00 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps" \
16:08:00 out   "$APPDIR/usr/share/doc/vidcue"
16:08:00 out   echo "==> Fetching static ffmpeg and ffprobe (cached)"
16:08:00 out   if [ ! -x "$FF_DIR/ffmpeg" ] || [ ! -x "$FF_DIR/ffprobe" ]; then
16:08:00 out   if [ ! -f "$FF_ARCHIVE" ]; then
16:08:00 out   curl -fL --retry 3 --retry-delay 2 -o "$FF_ARCHIVE" "$FFMPEG_URL"
16:08:00 out   fi
16:08:00 out   rm -rf "$FF_DIR"
16:08:00 out   mkdir -p "$FF_DIR"
16:08:00 out   tar -xJf "$FF_ARCHIVE" -C "$FF_DIR" --strip-components=1
16:08:00 out   fi
16:08:00 out   echo "==> Fetching appimagetool (cached)"
16:08:00 out   if [ ! -x "$APPIMAGETOOL" ]; then
16:08:00 out   if [ ! -f "$APPIMAGETOOL" ]; then
16:08:00 out   curl -fL --retry 3 --retry-delay 2 -o "$APPIMAGETOOL" "$APPIMAGETOOL_URL"
16:08:00 out   fi
16:08:00 out   chmod +x "$APPIMAGETOOL"
16:08:00 out   fi
16:08:00 out   echo "==> Staging AppDir"
16:08:00 out   install -Dm755 "$BIN" "$APPDIR/usr/bin/vidcue"
16:08:00 out   install -Dm755 "$FF_DIR/ffmpeg" "$APPDIR/usr/bin/ffmpeg"
16:08:00 out   install -Dm755 "$FF_DIR/ffprobe" "$APPDIR/usr/bin/ffprobe"
16:08:00 out   install -Dm644 "$ROOT/assets/vidcue.png" \
16:08:00 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png"
16:08:00 out   install -Dm644 "$ROOT/scripts/vidcue.desktop" \
16:08:00 out   "$APPDIR/usr/share/applications/vidcue.desktop"
16:08:00 out   install -Dm644 "$ROOT/README.md" "$APPDIR/usr/share/doc/vidcue/README.md"
16:08:00 out   install -Dm644 "$ROOT/MECHANICS.md" "$APPDIR/usr/share/doc/vidcue/MECHANICS.md"
16:08:00 out   install -Dm644 "$ROOT/LICENSE" "$APPDIR/usr/share/doc/vidcue/LICENSE"
16:08:00 out   install -Dm644 "$ROOT/assets/fonts/LICENSE-DejaVu.txt" \
16:08:00 out   "$APPDIR/usr/share/doc/vidcue/LICENSE-DejaVu.txt"
16:08:00 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png" "$APPDIR/vidcue.png"
16:08:00 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png" "$APPDIR/.DirIcon"
16:08:00 out   cp "$APPDIR/usr/share/applications/vidcue.desktop" "$APPDIR/vidcue.desktop"
16:08:00 out   cat > "$APPDIR/AppRun" <<'APPRUN'
16:08:00 out   #!/bin/sh
