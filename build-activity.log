23:27:11 out   23:26:53 out echo "Built $OUT"
23:27:11 out   23:26:53 out ls -lh "$OUT"
23:27:11 out   23:26:53 out #!/usr/bin/env python3
23:27:11 out   23:26:53 out """Draw the Cue Player app icon.
23:27:11 out   23:26:53 out Run from the app folder: python3 scripts/make-icon.py
23:27:11 out   23:26:53 out Requires Pillow. The committed PNG is used by the AppImage build; this script
23:27:11 out   23:26:53 out exists so the icon can be regenerated or recoloured later.
23:27:11 out   23:26:53 out """
23:27:11 out   23:26:53 out from pathlib import Path
23:27:11 out   23:26:53 out from PIL import Image, ImageDraw
23:27:11 out   23:26:53 out ROOT = Path(__file__).resolve().parent.parent
23:27:11 out   23:26:53 out OUT = ROOT / "assets" / "cue-player.png"
23:27:11 out   23:26:53 out BG = (11, 13, 16, 255)
23:27:11 out   23:26:53 out PANEL = (28, 32, 39, 255)
23:27:11 out   23:26:53 out AMBER = (230, 165, 74, 255)
23:27:11 out   23:26:53 out BRIGHT = (248, 186, 94, 255)
23:27:11 out   23:26:53 out DARK = (20, 17, 12, 255)
23:27:11 out   23:26:53 out def build(size: int) -> Image.Image:
23:27:11 out   23:26:53 out s = size / 512.0
23:27:11 out   23:26:53 out def r(*values):
23:27:11 out   23:26:53 out return tuple(round(v * s) for v in values)
23:27:11 out   23:26:53 out img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
23:27:11 out   23:26:53 out d = ImageDraw.Draw(img)
23:27:11 out   23:26:53 out d.rounded_rectangle(r(12, 12, 500, 500), radius=r(112)[0], fill=BG,
23:27:11 out   23:26:53 out outline=AMBER, width=max(1, r(9)[0]))
23:27:11 out   23:26:53 out # Film strip holes along the top and bottom.
23:27:11 out   23:26:53 out for x in (92, 172, 252, 332, 412):
23:27:11 out   23:26:53 out d.rounded_rectangle(r(x, 56, x + 36, 82), radius=r(6)[0], fill=PANEL)
23:27:11 out   23:26:53 out d.rounded_rectangle(r(x, 430, x + 36, 456), radius=r(6)[0], fill=PANEL)
23:27:11 out   23:26:53 out # Amber play mark.
23:27:11 out   23:26:53 out d.polygon(
23:27:11 out   23:26:53 out [r(198, 150), r(198, 362), r(372, 256)],
23:27:11 out   23:26:53 out fill=AMBER,
23:27:11 out   23:26:53 out )
23:27:11 out   23:26:53 out d.polygon(
23:27:11 out   23:26:53 out [r(216, 188), r(216, 324), r(328, 256)],
23:27:11 out   23:26:53 out fill=BRIGHT,
23:27:11 out   23:26:53 out )
23:27:11 out   23:26:53 out # Dark pupil in the play mark keeps it from looking like a solid wedge.
23:27:11 out   23:26:53 out d.polygon(
23:27:11 out   23:26:53 out [r(212, 192), r(212, 320), r(318, 256)],
23:27:11 out   23:26:53 out fill=DARK,
23:27:11 out   23:26:53 out )
23:27:11 out   23:26:53 out return img
23:27:11 out   23:26:53 out def main() -> None:
23:27:11 out   23:26:53 out OUT.parent.mkdir(parents=True, exist_ok=True)
23:27:11 out   23:26:53 out build(512).resize((256, 256), Image.LANCZOS).save(OUT)
23:27:11 out   23:26:53 out print(f"wrote {OUT}")
23:27:11 out   23:26:53 out if __name__ == "__main__":
23:27:11 out   23:26:53 out main()
