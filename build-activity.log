01:00:22 out   "set Audacity to 00h00m00.000s".to_string()
01:00:22 out   };
01:00:22 out   set_state(
01:00:22 out   &state,
01:00:22 out   Snapshot {
01:00:22 out   connected: true,
01:00:22 out   position: Some(position),
01:00:22 out   moving,
01:00:22 out   format_ok,
01:00:22 out   message,
01:00:22 out   },
01:00:22 out   );
01:00:22 out   } else {
01:00:22 out   // The node was found but its text is not a timecode we
01:00:22 out   // understand. Re-discover soon in case Audacity swapped
01:00:22 out   // the timecode display.
01:00:22 out   node = None;
01:00:22 out   last_position = None;
01:00:22 out   last_change = None;
01:00:22 out   set_state(
01:00:22 out   &state,
01:00:22 out   Snapshot {
01:00:22 out   connected: false,
01:00:22 out   position: None,
01:00:22 out   moving: false,
01:00:22 out   format_ok: false,
01:00:22 out   message: "timecode format not recognised".to_string(),
01:00:22 out   },
01:00:22 out   );
01:00:22 out   }
01:00:22 out   }
01:00:22 out   Err(_) => {
01:00:22 out   node = None;
01:00:22 out   last_position = None;
01:00:22 out   last_change = None;
01:00:22 out   set_state(
01:00:22 out   &state,
01:00:22 out   Snapshot {
01:00:22 out   connected: false,
01:00:22 out   position: None,
01:00:22 out   moving: false,
01:00:22 out   format_ok: false,
