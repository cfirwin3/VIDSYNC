14:38:41 out   /// Focus Audacity, tap its default Play/Stop key (Space), and hand focus
14:38:41 out   /// back to VidCue. The key is sent with XTest so Audacity treats it as
14:38:41 out   /// a real key press.
14:38:41 out   pub fn send_space(&mut self) -> Result<(), String> {
14:38:41 out   self.refresh();
14:38:41 out   if !self.enabled {
14:38:41 out   return Ok(());
14:38:41 out   }
14:38:41 out   let Some(x) = self.x11.as_ref() else {
14:38:41 out   let message = self
14:38:41 out   .load_error
14:38:41 out   .clone()
14:38:41 out   .unwrap_or_else(|| "X11 keyboard support is unavailable".to_string());
