02:04:50 out   fn ensure_sample() -> PathBuf {
02:04:50 out   let path = std::env::temp_dir().join("vidsync-sample.mp4");
02:04:50 out   let needs_write = fs::metadata(&path)
02:04:50 out   .map(|m| m.len() != SAMPLE.len() as u64)
02:04:50 out   .unwrap_or(true);
02:04:50 out   if needs_write {
02:04:50 out   let _ = fs::write(&path, SAMPLE);
02:04:50 out   }
02:04:50 out   path
02:04:50 out   }
02:04:50 out   async fn run_self_test(app: &mut App, out: &Path) {
02:04:50 out   let mut results: Vec<(String, bool, String)> = Vec::new();
02:04:50 out   let sample = ensure_sample();
02:04:50 out   app.load_media(sample);
02:04:50 out   // The self-test drives its own clock; do not let a running Audacity
02:04:50 out   // replace the first preview while the sample is loading.
