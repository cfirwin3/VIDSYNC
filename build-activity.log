14:38:48 out   app.field.focus();
14:38:48 out   for ch in "00:00:04.000".chars() {
14:38:48 out   app.field.type_char(ch);
14:38:48 out   }
14:38:48 out   let typed = app.field.press_enter();
14:38:48 out   if let Some(v) = typed {
14:38:48 out   app.apply_start(v);
14:38:48 out   }
14:38:48 out   let applied = (app.start_marker - 4.0).abs() < 0.06 && (app.player.position - 4.0).abs() < 0.12;
14:38:48 out   app.action_play();
14:38:48 out   let p0 = app.player.position;
14:38:48 out   for _ in 0..45 {
14:38:48 out   app.tick(1.0 / 60.0);
14:38:48 out   app.draw();
14:38:48 out   next_frame().await;
14:38:48 out   }
14:38:48 out   let advanced = app.player.position - p0;
