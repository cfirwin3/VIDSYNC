22:53:21 out   "Reading the first frame…",
22:53:21 out   cx,
22:53:21 out   cy + 18.0,
22:53:21 out   12,
22:53:21 out   MUTED,
22:53:21 out   );
22:53:21 out   }
22:53:21 out   // status chip, top-left of the picture
22:53:21 out   let chip = Rect::new(dx + 14.0, dy + 14.0, 96.0, 26.0);
22:53:21 out   rounded_rect(
