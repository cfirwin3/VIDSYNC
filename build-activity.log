14:45:00 out   #!/usr/bin/env bash
14:45:00 out   # Build a self-contained VidCue AppImage.
14:45:00 out   #
14:45:00 out   # ./scripts/build-appimage.sh
14:45:00 out   #
14:45:00 out   # It downloads a static ffmpeg/ffprobe build and appimagetool into build/cache
14:45:00 out   # the first time, stages build/VidCue.AppDir, and writes dist/*.AppImage.
14:45:00 out   # No FUSE is needed: the tool is run with APPIMAGE_EXTRACT_AND_RUN=1.
14:45:00 out   set -euo pipefail
14:45:00 out   ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
14:45:00 out   cd "$ROOT"
14:45:00 out   APP="VidCue"
14:45:00 out   ARCH="${ARCH:-x86_64}"
14:45:00 out   VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
14:45:00 out   if [ -z "$VERSION" ]; then
14:45:00 out   echo "Could not read the version from Cargo.toml" >&2
14:45:00 out   exit 1
14:45:00 out   fi
14:45:00 out   case "$ARCH" in
14:45:00 out   x86_64)
14:45:00 out   FFMPEG_URL="https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
14:45:00 out   APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
14:45:00 out   ;;
14:45:00 out   *)
14:45:00 out   echo "Only x86_64 AppImages are supported by this script (got ARCH=$ARCH)." >&2
14:45:00 out   echo "Set ARCH=x86_64 or adapt the download URLs." >&2
14:45:00 out   exit 1
14:45:00 out   ;;
14:45:00 out   esac
14:45:00 out   BUILD="$ROOT/build"
14:45:00 out   CACHE="$BUILD/cache"
14:45:00 out   APPDIR="$BUILD/$APP.AppDir"
14:45:00 out   DIST="$ROOT/dist"
14:45:00 out   BIN="$ROOT/target/release/cue-video-player"
14:45:00 out   FF_DIR="$CACHE/ffmpeg-static"
14:45:00 out   FF_ARCHIVE="$CACHE/ffmpeg-static.tar.xz"
14:45:00 out   APPIMAGETOOL="$CACHE/appimagetool-$ARCH.AppImage"
14:45:00 out   OUT="$DIST/$APP-$VERSION-$ARCH.AppImage"
14:45:00 out   need() {
14:45:00 out   command -v "$1" >/dev/null 2>&1 || {
14:45:00 out   echo "Missing required command: $1" >&2
14:45:00 out   exit 1
14:45:00 out   }
14:45:00 out   }
14:45:00 out   need cargo
14:45:00 out   need curl
14:45:00 out   need tar
14:45:00 out   need xz
14:45:00 out   echo "==> Building release binary"
14:45:00 out   cargo build --release --locked
14:45:00 out   echo "==> Preparing build folders"
14:45:00 out   mkdir -p "$CACHE" "$DIST"
14:45:00 out   rm -rf "$APPDIR"
14:45:00 out   mkdir -p "$APPDIR/usr/bin" \
14:45:00 out   "$APPDIR/usr/share/applications" \
14:45:00 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps" \
14:45:00 out   "$APPDIR/usr/share/doc/vidcue"
14:45:00 out   echo "==> Fetching static ffmpeg and ffprobe (cached)"
14:45:00 out   if [ ! -x "$FF_DIR/ffmpeg" ] || [ ! -x "$FF_DIR/ffprobe" ]; then
14:45:00 out   if [ ! -f "$FF_ARCHIVE" ]; then
14:45:00 out   curl -fL --retry 3 --retry-delay 2 -o "$FF_ARCHIVE" "$FFMPEG_URL"
14:45:00 out   fi
14:45:00 out   rm -rf "$FF_DIR"
14:45:00 out   mkdir -p "$FF_DIR"
14:45:00 out   tar -xJf "$FF_ARCHIVE" -C "$FF_DIR" --strip-components=1
14:45:00 out   fi
14:45:00 out   echo "==> Fetching appimagetool (cached)"
14:45:00 out   if [ ! -x "$APPIMAGETOOL" ]; then
14:45:00 out   if [ ! -f "$APPIMAGETOOL" ]; then
14:45:00 out   curl -fL --retry 3 --retry-delay 2 -o "$APPIMAGETOOL" "$APPIMAGETOOL_URL"
14:45:00 out   fi
14:45:00 out   chmod +x "$APPIMAGETOOL"
14:45:00 out   fi
14:45:00 out   echo "==> Staging AppDir"
14:45:00 out   install -Dm755 "$BIN" "$APPDIR/usr/bin/vidcue"
14:45:00 out   install -Dm755 "$FF_DIR/ffmpeg" "$APPDIR/usr/bin/ffmpeg"
14:45:00 out   install -Dm755 "$FF_DIR/ffprobe" "$APPDIR/usr/bin/ffprobe"
14:45:00 out   install -Dm644 "$ROOT/assets/vidcue.png" \
14:45:00 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png"
14:45:00 out   install -Dm644 "$ROOT/scripts/vidcue.desktop" \
14:45:00 out   "$APPDIR/usr/share/applications/vidcue.desktop"
14:45:00 out   install -Dm644 "$ROOT/README.md" "$APPDIR/usr/share/doc/vidcue/README.md"
14:45:00 out   install -Dm644 "$ROOT/MECHANICS.md" "$APPDIR/usr/share/doc/vidcue/MECHANICS.md"
14:45:00 out   install -Dm644 "$ROOT/LICENSE" "$APPDIR/usr/share/doc/vidcue/LICENSE"
14:45:00 out   install -Dm644 "$ROOT/assets/fonts/LICENSE-DejaVu.txt" \
14:45:00 out   "$APPDIR/usr/share/doc/vidcue/LICENSE-DejaVu.txt"
14:45:00 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png" "$APPDIR/vidcue.png"
14:45:00 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png" "$APPDIR/.DirIcon"
14:45:00 out   cp "$APPDIR/usr/share/applications/vidcue.desktop" "$APPDIR/vidcue.desktop"
14:45:00 out   cat > "$APPDIR/AppRun" <<'APPRUN'
14:45:00 out   #!/bin/sh
14:45:00 out   # AppRun for VidCue. Keep ffmpeg and ffprobe next to the binary.
14:45:00 out   set -eu
14:45:00 out   HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
14:45:00 out   export APPDIR="$HERE"
14:45:00 out   export PATH="$HERE/usr/bin:${PATH:-/usr/bin:/bin}"
14:45:00 out   exec "$HERE/usr/bin/vidcue" "$@"
14:45:00 out   APPRUN
14:45:00 out   chmod +x "$APPDIR/AppRun"
14:45:00 out   if command -v desktop-file-validate >/dev/null 2>&1; then
14:45:00 out   desktop-file-validate "$APPDIR/usr/share/applications/vidcue.desktop" || true
14:45:00 out   fi
14:45:00 out   echo "==> Packing AppImage"
14:45:00 out   rm -f "$OUT"
14:45:00 out   APPIMAGE_EXTRACT_AND_RUN=1 ARCH="$ARCH" \
14:45:00 out   "$APPIMAGETOOL" --no-appstream "$APPDIR" "$OUT"
14:45:00 out   chmod +x "$OUT"
14:45:00 out   echo
14:45:00 out   echo "Built $OUT"
14:45:00 out   ls -lh "$OUT"
