01:40:24 out   +/// Scale the bundled app icon down to the three sizes the window manager asks
01:40:24 out   +/// for. The icon is the same rounded tile and play mark drawn beside the name.
01:40:24 out   +fn icon_at(source: &Image, size: usize) -> Vec<u8> {
01:40:24 out   + let mut out = vec![0u8; size * size * 4];
01:40:24 out   + let sw = source.width as usize;
01:40:24 out   + let sh = source.height as usize;
01:40:24 out   + if sw == 0 || sh == 0 {
01:40:24 out   + return out;
01:40:24 out   + }
01:40:24 out   + for y in 0..size {
01:40:24 out   + let sy = ((y as f32 + 0.5) * sh as f32 / size as f32) as usize;
01:40:24 out   + let sy = sy.min(sh - 1);
01:40:24 out   + for x in 0..size {
01:40:24 out   + let sx = ((x as f32 + 0.5) * sw as f32 / size as f32) as usize;
01:40:24 out   + let sx = sx.min(sw - 1);
01:40:24 out   + let src = (sy * sw + sx) * 4;
01:40:24 out   + let dst = (y * size + x) * 4;
01:40:24 out   + if src + 3 < source.bytes.len() {
01:40:24 out   + out[dst..dst + 4].copy_from_slice(&source.bytes[src..src + 4]);
01:40:24 out   + }
01:40:24 out   + }
01:40:24 out   + }
01:40:24 out   + out
01:40:24 out   +}
