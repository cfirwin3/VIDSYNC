17:35:43 out   let small: [u8; 16 * 16 * 4] = icon_at(&image, 16).try_into().ok()?;
17:35:43 out   let medium: [u8; 32 * 32 * 4] = icon_at(&image, 32).try_into().ok()?;
17:35:43 out   let big: [u8; 64 * 64 * 4] = icon_at(&image, 64).try_into().ok()?;
17:35:43 out   Some(macroquad::miniquad::conf::Icon { small, medium, big })
17:35:43 out   }
