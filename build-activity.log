02:38:14 out   pub fn fmt_time(seconds: f64, millis: bool) -> String {
02:38:14 out   let t = seconds.max(0.0);
02:38:14 out   let total_ms = (t * 1000.0).round() as u64;
02:38:14 out   let ms = total_ms % 1000;
02:38:14 out   let total = total_ms / 1000;
02:38:14 out   let h = total / 3600;
02:38:14 out   let m = (total % 3600) / 60;
02:38:14 out   let s = total % 60;
02:38:14 out   if millis {
02:38:14 out   format!("{:02}:{:02}:{:02}.{:03}", h, m, s, ms)
02:38:14 out   } else {
02:38:14 out   format!("{:02}:{:02}:{:02}", h, m, s)
02:38:14 out   }
02:38:14 out   }
02:38:14 out   /// Parse hours:minutes:seconds, minutes:seconds, or plain seconds.
02:38:14 out   /// Fractional seconds are accepted.
02:38:14 out   pub fn parse_time(input: &str) -> Option<f64> {
02:38:14 out   let s = input.trim();
02:38:14 out   if s.is_empty() {
02:38:14 out   return None;
02:38:14 out   }
02:38:14 out   let parts: Vec<&str> = s.split(':').collect();
02:38:14 out   if parts.len() > 3 {
02:38:14 out   return None;
02:38:14 out   }
02:38:14 out   let mut total = 0.0;
02:38:14 out   for (i, raw) in parts.iter().enumerate() {
02:38:14 out   let raw = raw.trim();
02:38:14 out   if raw.is_empty() {
02:38:14 out   return None;
02:38:14 out   }
02:38:14 out   let value: f64 = raw.parse().ok()?;
02:38:14 out   if !value.is_finite() || value < 0.0 {
02:38:14 out   return None;
02:38:14 out   }
02:38:14 out   let multiplier = match parts.len() - i {
02:38:14 out   1 => 1.0,
02:38:14 out   2 => 60.0,
02:38:14 out   3 => 3600.0,
02:38:14 out   _ => return None,
02:38:14 out   };
02:38:14 out   total += value * multiplier;
02:38:14 out   }
02:38:14 out   if total.is_finite() {
02:38:14 out   Some(total)
02:38:14 out   } else {
02:38:14 out   None
02:38:14 out   }
02:38:14 out   }
