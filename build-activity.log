14:38:48 out   advanced
14:38:48 out   ),
14:38:48 out   ));
14:38:48 out   // hud: transport clock and start field are really painted.
14:38:48 out   app.tick(1.0 / 60.0);
14:38:48 out   app.draw();
14:38:48 out   let img = get_screen_data();
