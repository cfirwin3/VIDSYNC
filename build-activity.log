02:38:14 out   draw_text_ex(
02:38:14 out   s,
02:38:14 out   x,
02:38:14 out   y + d.offset_y,
02:38:14 out   TextParams {
02:38:14 out   font: Some(font),
02:38:14 out   font_size: size,
02:38:14 out   color,
02:38:14 out   ..Default::default()
