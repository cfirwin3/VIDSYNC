23:31:26 out   #!/usr/bin/env bash
23:31:26 out   # Build a self-contained Cue Player AppImage.
23:31:26 out   #
23:31:26 out   # ./scripts/build-appimage.sh
23:31:26 out   #
23:31:26 out   # It downloads a static ffmpeg/ffprobe build and appimagetool into build/cache
23:31:26 out   # the first time, stages build/CuePlayer.AppDir, and writes dist/*.AppImage.
23:31:26 out   # No FUSE is needed: the tool is run with APPIMAGE_EXTRACT_AND_RUN=1.
23:31:26 out   set -euo pipefail
23:31:26 out   ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
23:31:26 out   cd "$ROOT"
23:31:26 out   APP="CuePlayer"
23:31:26 out   ARCH="${ARCH:-x86_64}"
23:31:26 out   VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
23:31:26 out   if [ -z "$VERSION" ]; then
23:31:26 out   echo "Could not read the version from Cargo.toml" >&2
23:31:26 out   exit 1
23:31:26 out   fi
23:31:26 out   case "$ARCH" in
23:31:26 out   x86_64)
23:31:26 out   FFMPEG_URL="https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
23:31:26 out   APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
23:31:26 out   ;;
23:31:26 out   *)
23:31:26 out   echo "Only x86_64 AppImages are supported by this script (got ARCH=$ARCH)." >&2
23:31:26 out   echo "Set ARCH=x86_64 or adapt the download URLs." >&2
23:31:26 out   exit 1
23:31:26 out   ;;
23:31:26 out   esac
23:31:26 out   BUILD="$ROOT/build"
23:31:26 out   CACHE="$BUILD/cache"
23:31:26 out   APPDIR="$BUILD/$APP.AppDir"
23:31:26 out   DIST="$ROOT/dist"
23:31:26 out   BIN="$ROOT/target/release/cue-video-player"
23:31:26 out   FF_DIR="$CACHE/ffmpeg-static"
23:31:26 out   FF_ARCHIVE="$CACHE/ffmpeg-static.tar.xz"
