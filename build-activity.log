16:02:50 out   unsafe fn walk_windows(
16:02:50 out   x: &X11,
16:02:50 out   dpy: *mut Display,
16:02:50 out   window: Window,
16:02:50 out   needle: &str,
16:02:50 out   best: &mut Option<(Window, String, i64)>,
16:02:50 out   depth: u32,
16:02:50 out   ) {
16:02:50 out   if depth > 12 {
16:02:50 out   return;
16:02:50 out   }
16:02:50 out   let mut attrs: XWindowAttributes = std::mem::zeroed();
16:02:50 out   if (x.get_window_attributes)(dpy, window, &mut attrs) != 0
16:02:50 out   && attrs.map_state == IS_VIEWABLE
16:02:50 out   && attrs.width > 0
16:02:50 out   && attrs.height > 0
16:02:50 out   {
16:02:50 out   let class = window_class(x, dpy, window);
16:02:50 out   let title = window_name(x, dpy, window);
16:02:50 out   let label = format!("{class} {title}").to_ascii_lowercase();
16:02:50 out   if label.contains(needle) {
16:02:50 out   let area = attrs.width as i64 * attrs.height as i64;
16:02:50 out   if best.as_ref().map(|(_, _, a)| area > *a).unwrap_or(true) {
16:02:50 out   *best = Some((window, title, area));
16:02:50 out   }
16:02:50 out   }
16:02:50 out   }
16:02:50 out   let mut root_return: Window = 0;
16:02:50 out   let mut parent_return: Window = 0;
16:02:50 out   let mut children: *mut Window = ptr::null_mut();
16:02:50 out   let mut child_count: c_uint = 0;
16:02:50 out   if (x.query_tree)(
16:02:50 out   dpy,
16:02:50 out   window,
16:02:50 out   &mut root_return,
16:02:50 out   &mut parent_return,
16:02:50 out   &mut children,
16:02:50 out   &mut child_count,
16:02:50 out   ) != 0
16:02:50 out   && !children.is_null()
16:02:50 out   {
16:02:50 out   for i in 0..child_count as usize {
16:02:50 out   walk_windows(x, dpy, *children.add(i), needle, best, depth + 1);
16:02:50 out   }
16:02:50 out   (x.free)(children as *mut c_void);
16:02:50 out   }
16:02:50 out   }
16:02:50 out   unsafe fn find_window(x: &X11, dpy: *mut Display, needle: &str) -> Option<(Window, String)> {
16:02:50 out   let screen = (x.default_screen)(dpy);
16:02:50 out   let root = (x.root_window)(dpy, screen);
16:02:50 out   let mut best = None;
16:02:50 out   walk_windows(x, dpy, root, needle, &mut best, 0);
16:02:50 out   best.map(|(window, title, _)| (window, title))
16:02:50 out   }
