22:53:28 out   --- scripts/make-icon.py
22:53:28 out   #!/usr/bin/env python3
22:53:28 out   """Draw the Cue Player app icon.
22:53:28 out   Run from the app folder: python3 scripts/make-icon.py
22:53:28 out   Requires Pillow. The committed PNG is used by the AppImage build; this script
22:53:28 out   exists so the icon can be regenerated or recoloured later.
22:53:28 out   """
22:53:28 out   from pathlib import Path
22:53:28 out   from PIL import Image, ImageDraw
22:53:28 out   ROOT = Path(__file__).resolve().parent.parent
22:53:28 out   OUT = ROOT / "assets" / "cue-player.png"
22:53:28 out   BG = (11, 13, 16, 255)
22:53:28 out   PANEL = (28, 32, 39, 255)
22:53:28 out   AMBER = (230, 165, 74, 255)
22:53:28 out   BRIGHT = (248, 186, 94, 255)
22:53:28 out   DARK = (20, 17, 12, 255)
22:53:28 out   def build(size: int) -> Image.Image:
