01:00:22 out   //! Audacity 4.0 timecode over the accessibility bus.
01:00:22 out   //!
01:00:22 out   //! Audacity 4.0 is a Qt application and publishes its playback position as an
01:00:22 out   //! AT-SPI accessible value (`Playback position:00 h 00 m 11.037 s`). Reading
01:00:22 out   //! that value is independent of which window is on top, so VidCue can follow
01:00:22 out   //! Audacity even while it is behind another window or minimised.
01:00:22 out   //!
01:00:22 out   //! A background thread discovers the Audacity accessible tree, caches the node
01:00:22 out   //! that holds the timecode, and polls it about thirty times a second. The UI
01:00:22 out   //! only reads a small snapshot, so a slow or missing Audacity never stalls the
01:00:22 out   //! video.
01:00:22 out   use std::error::Error;
01:00:22 out   use std::sync::atomic::{AtomicBool, Ordering};
01:00:22 out   use std::sync::{Arc, Mutex};
01:00:22 out   use std::thread;
01:00:22 out   use std::time::{Duration, Instant};
01:00:22 out   use zbus::blocking::{Connection, Proxy};
01:00:22 out   use zbus::zvariant::{OwnedObjectPath, OwnedValue};
01:00:22 out   const POLL: Duration = Duration::from_millis(33);
01:00:22 out   const REDISCOVER: Duration = Duration::from_millis(1500);
