17:36:07 out   #!/usr/bin/env python3
17:36:07 out   """Draw the VIDSYNC app icon.
17:36:07 out   The icon mirrors the small logo shown to the left of the VIDSYNC wordmark: a
17:36:07 out   soft purple rounded square with a bright purple play triangle. Run from the app
17:36:07 out   folder with ``python3 scripts/make-icon.py``; Pillow is required.
17:36:07 out   """
17:36:07 out   from pathlib import Path
17:36:07 out   from PIL import Image, ImageDraw
17:36:07 out   ROOT = Path(__file__).resolve().parent.parent
17:36:07 out   OUT = ROOT / "assets" / "vidsync.png"
17:36:07 out   # Colours sampled from the in-app logo (purple accent over the dark header).
17:36:07 out   SOFT_PURPLE = (37, 30, 52, 255)
17:36:07 out   PLAY_PURPLE = (176, 122, 239, 255)
17:36:07 out   def build(size: int) -> Image.Image:
17:36:07 out   s = size / 512.0
17:36:07 out   def r(*values):
17:36:07 out   return tuple(round(v * s) for v in values)
17:36:07 out   img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
17:36:07 out   d = ImageDraw.Draw(img)
17:36:07 out   # The rounded tile and the play mark keep the same proportions as the
17:36:07 out   # in-app logo (radius 30% of the tile, triangle 44% high).
17:36:07 out   d.rounded_rectangle(r(12, 12, 500, 500), radius=r(146)[0], fill=SOFT_PURPLE)
17:36:07 out   d.polygon(
17:36:07 out   [r(202, 161), r(202, 375), r(379, 268)],
17:36:07 out   fill=PLAY_PURPLE,
17:36:07 out   )
17:36:07 out   return img
17:36:07 out   def main() -> None:
17:36:07 out   OUT.parent.mkdir(parents=True, exist_ok=True)
17:36:07 out   build(512).resize((256, 256), Image.LANCZOS).save(OUT)
17:36:07 out   print(f"wrote {OUT}")
17:36:07 out   if __name__ == "__main__":
17:36:07 out   main()
