02:05:47 out   if millis {
02:05:47 out   format!("{:02}:{:02}:{:02}.{:03}", h, m, s, ms)
02:05:47 out   } else {
02:05:47 out   format!("{:02}:{:02}:{:02}", h, m, s)
02:05:47 out   }
02:05:47 out   }
