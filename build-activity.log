02:38:47 out   #!/usr/bin/env bash
02:38:47 out   # Build a self-contained VidCue AppImage.
02:38:47 out   #
02:38:47 out   # ./scripts/build-appimage.sh
02:38:47 out   #
02:38:47 out   # It downloads a static ffmpeg/ffprobe build and appimagetool into build/cache
02:38:47 out   # the first time, stages build/VidCue.AppDir, and writes dist/*.AppImage.
02:38:47 out   # No FUSE is needed: the tool is run with APPIMAGE_EXTRACT_AND_RUN=1.
02:38:47 out   set -euo pipefail
02:38:47 out   ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
02:38:47 out   cd "$ROOT"
02:38:47 out   APP="VidCue"
02:38:47 out   ARCH="${ARCH:-x86_64}"
02:38:47 out   VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
02:38:47 out   if [ -z "$VERSION" ]; then
02:38:47 out   echo "Could not read the version from Cargo.toml" >&2
02:38:47 out   exit 1
02:38:47 out   fi
02:38:47 out   case "$ARCH" in
02:38:47 out   x86_64)
02:38:47 out   FFMPEG_URL="https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
02:38:47 out   APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
02:38:47 out   ;;
02:38:47 out   *)
02:38:47 out   echo "Only x86_64 AppImages are supported by this script (got ARCH=$ARCH)." >&2
02:38:47 out   echo "Set ARCH=x86_64 or adapt the download URLs." >&2
02:38:47 out   exit 1
02:38:47 out   ;;
02:38:47 out   esac
02:38:47 out   BUILD="$ROOT/build"
02:38:47 out   CACHE="$BUILD/cache"
02:38:47 out   APPDIR="$BUILD/$APP.AppDir"
02:38:47 out   DIST="$ROOT/dist"
02:38:47 out   BIN="$ROOT/target/release/cue-video-player"
02:38:47 out   FF_DIR="$CACHE/ffmpeg-static"
02:38:47 out   FF_ARCHIVE="$CACHE/ffmpeg-static.tar.xz"
02:38:47 out   APPIMAGETOOL="$CACHE/appimagetool-$ARCH.AppImage"
02:38:47 out   OUT="$DIST/$APP-$VERSION-$ARCH.AppImage"
02:38:47 out   need() {
02:38:47 out   command -v "$1" >/dev/null 2>&1 || {
02:38:47 out   echo "Missing required command: $1" >&2
02:38:47 out   exit 1
02:38:47 out   }
02:38:47 out   }
02:38:47 out   need cargo
02:38:47 out   need curl
02:38:47 out   need tar
02:38:47 out   need xz
02:38:47 out   echo "==> Building release binary"
02:38:47 out   cargo build --release --locked
02:38:47 out   echo "==> Preparing build folders"
02:38:47 out   mkdir -p "$CACHE" "$DIST"
02:38:47 out   rm -rf "$APPDIR"
02:38:47 out   mkdir -p "$APPDIR/usr/bin" \
02:38:47 out   "$APPDIR/usr/share/applications" \
02:38:47 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps" \
02:38:47 out   "$APPDIR/usr/share/doc/vidcue"
02:38:47 out   echo "==> Fetching static ffmpeg and ffprobe (cached)"
02:38:47 out   if [ ! -x "$FF_DIR/ffmpeg" ] || [ ! -x "$FF_DIR/ffprobe" ]; then
02:38:47 out   if [ ! -f "$FF_ARCHIVE" ]; then
02:38:47 out   curl -fL --retry 3 --retry-delay 2 -o "$FF_ARCHIVE" "$FFMPEG_URL"
02:38:47 out   fi
02:38:47 out   rm -rf "$FF_DIR"
02:38:47 out   mkdir -p "$FF_DIR"
02:38:47 out   tar -xJf "$FF_ARCHIVE" -C "$FF_DIR" --strip-components=1
02:38:47 out   fi
02:38:47 out   echo "==> Fetching appimagetool (cached)"
02:38:47 out   if [ ! -x "$APPIMAGETOOL" ]; then
02:38:47 out   if [ ! -f "$APPIMAGETOOL" ]; then
02:38:47 out   curl -fL --retry 3 --retry-delay 2 -o "$APPIMAGETOOL" "$APPIMAGETOOL_URL"
02:38:47 out   fi
02:38:47 out   chmod +x "$APPIMAGETOOL"
02:38:47 out   fi
02:38:47 out   echo "==> Staging AppDir"
02:38:47 out   install -Dm755 "$BIN" "$APPDIR/usr/bin/vidcue"
02:38:47 out   install -Dm755 "$FF_DIR/ffmpeg" "$APPDIR/usr/bin/ffmpeg"
02:38:47 out   install -Dm755 "$FF_DIR/ffprobe" "$APPDIR/usr/bin/ffprobe"
02:38:47 out   install -Dm644 "$ROOT/assets/vidcue.png" \
02:38:47 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidcue.png"
02:38:47 out   install -Dm644 "$ROOT/scripts/vidcue.desktop" \
02:38:47 out   "$APPDIR/usr/share/applications/vidcue.desktop"
02:38:47 out   install -Dm644 "$ROOT/README.md" "$APPDIR/usr/share/doc/vidcue/README.md"
02:38:47 out   install -Dm644 "$ROOT/MECHANICS.md" "$APPDIR/usr/share/doc/vidcue/MECHANICS.md"
02:38:47 out   install -Dm644 "$ROOT/LICENSE" "$APPDIR/usr/share/doc/vidcue/LICENSE"
02:38:47 out   install -Dm644 "$ROOT/assets/fonts/LICENSE-DejaVu.txt" \
