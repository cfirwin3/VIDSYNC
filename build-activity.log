18:25:14 out   name = "vidsync"
18:25:14 out   version = "1.0.0"
18:25:14 out   edition = "2021"
18:25:14 out   description = "VIDSYNC - a video player that follows Audacity 4.0's timecode"
18:25:14 out   license = "MIT"
18:25:14 out   [dependencies]
18:25:14 out   macroquad = "0.4.16"
18:25:14 out   serde_json = "1"
18:25:14 out   zbus = "5.19"
18:25:14 out   [profile.release]
18:25:14 out   opt-level = 3
18:25:14 out   lto = true
18:25:14 out   codegen-units = 1
18:25:14 out   strip = true
18:25:14 out   #!/usr/bin/env bash
18:25:14 out   # Build a self-contained VIDSYNC AppImage.
18:25:14 out   #
18:25:14 out   # ./scripts/build-appimage.sh
18:25:14 out   #
18:25:14 out   # It downloads a static ffmpeg/ffprobe build and appimagetool into build/cache
18:25:14 out   # the first time, stages build/VIDSYNC.AppDir, and writes dist/*.AppImage.
18:25:14 out   # No FUSE is needed: the tool is run with APPIMAGE_EXTRACT_AND_RUN=1.
18:25:14 out   set -euo pipefail
18:25:14 out   ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
18:25:14 out   cd "$ROOT"
18:25:14 out   APP="VIDSYNC"
18:25:14 out   ARCH="${ARCH:-x86_64}"
18:25:14 out   VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
18:25:14 out   if [ -z "$VERSION" ]; then
18:25:14 out   echo "Could not read the version from Cargo.toml" >&2
18:25:14 out   exit 1
18:25:14 out   fi
18:25:14 out   case "$ARCH" in
18:25:14 out   x86_64)
18:25:14 out   FFMPEG_URL="https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
18:25:14 out   APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
18:25:14 out   ;;
18:25:14 out   *)
18:25:14 out   echo "Only x86_64 AppImages are supported by this script (got ARCH=$ARCH)." >&2
18:25:14 out   echo "Set ARCH=x86_64 or adapt the download URLs." >&2
18:25:14 out   exit 1
18:25:14 out   ;;
18:25:14 out   esac
18:25:14 out   BUILD="$ROOT/build"
18:25:14 out   CACHE="$BUILD/cache"
18:25:14 out   APPDIR="$BUILD/$APP.AppDir"
18:25:14 out   DIST="$ROOT/dist"
18:25:14 out   BIN="$ROOT/target/release/vidsync"
18:25:14 out   FF_DIR="$CACHE/ffmpeg-static"
18:25:14 out   FF_ARCHIVE="$CACHE/ffmpeg-static.tar.xz"
18:25:14 out   APPIMAGETOOL="$CACHE/appimagetool-$ARCH.AppImage"
18:25:14 out   OUT="$DIST/$APP-$VERSION-$ARCH.AppImage"
18:25:14 out   need() {
18:25:14 out   command -v "$1" >/dev/null 2>&1 || {
18:25:14 out   echo "Missing required command: $1" >&2
18:25:14 out   exit 1
18:25:14 out   }
18:25:14 out   }
18:25:14 out   need cargo
18:25:14 out   need curl
18:25:14 out   need tar
18:25:14 out   need xz
18:25:14 out   echo "==> Building release binary"
18:25:14 out   cargo build --release --locked
18:25:14 out   echo "==> Preparing build folders"
18:25:14 out   mkdir -p "$CACHE" "$DIST"
18:25:14 out   rm -rf "$APPDIR"
18:25:14 out   mkdir -p "$APPDIR/usr/bin" \
18:25:14 out   "$APPDIR/usr/share/applications" \
18:25:14 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps" \
18:25:14 out   "$APPDIR/usr/share/doc/vidsync"
18:25:14 out   echo "==> Fetching static ffmpeg and ffprobe (cached)"
18:25:14 out   if [ ! -x "$FF_DIR/ffmpeg" ] || [ ! -x "$FF_DIR/ffprobe" ]; then
18:25:14 out   if [ ! -f "$FF_ARCHIVE" ]; then
18:25:14 out   curl -fL --retry 3 --retry-delay 2 -o "$FF_ARCHIVE" "$FFMPEG_URL"
18:25:14 out   fi
18:25:14 out   rm -rf "$FF_DIR"
18:25:14 out   mkdir -p "$FF_DIR"
18:25:14 out   tar -xJf "$FF_ARCHIVE" -C "$FF_DIR" --strip-components=1
18:25:14 out   fi
18:25:14 out   echo "==> Fetching appimagetool (cached)"
18:25:14 out   if [ ! -x "$APPIMAGETOOL" ]; then
18:25:14 out   if [ ! -f "$APPIMAGETOOL" ]; then
18:25:14 out   curl -fL --retry 3 --retry-delay 2 -o "$APPIMAGETOOL" "$APPIMAGETOOL_URL"
18:25:14 out   fi
18:25:14 out   chmod +x "$APPIMAGETOOL"
18:25:14 out   fi
18:25:14 out   echo "==> Staging AppDir"
18:25:14 out   install -Dm755 "$BIN" "$APPDIR/usr/bin/vidsync"
18:25:14 out   install -Dm755 "$FF_DIR/ffmpeg" "$APPDIR/usr/bin/ffmpeg"
18:25:14 out   install -Dm755 "$FF_DIR/ffprobe" "$APPDIR/usr/bin/ffprobe"
18:25:14 out   install -Dm644 "$ROOT/assets/vidsync.png" \
18:25:14 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidsync.png"
18:25:14 out   install -Dm644 "$ROOT/scripts/vidsync.desktop" \
18:25:14 out   "$APPDIR/usr/share/applications/vidsync.desktop"
18:25:14 out   install -Dm644 "$ROOT/README.md" "$APPDIR/usr/share/doc/vidsync/README.md"
18:25:14 out   install -Dm644 "$ROOT/MECHANICS.md" "$APPDIR/usr/share/doc/vidsync/MECHANICS.md"
18:25:14 out   install -Dm644 "$ROOT/LICENSE" "$APPDIR/usr/share/doc/vidsync/LICENSE"
18:25:14 out   install -Dm644 "$ROOT/assets/fonts/LICENSE-DejaVu.txt" \
18:25:14 out   "$APPDIR/usr/share/doc/vidsync/LICENSE-DejaVu.txt"
18:25:14 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidsync.png" "$APPDIR/vidsync.png"
18:25:14 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/vidsync.png" "$APPDIR/.DirIcon"
18:25:14 out   cp "$APPDIR/usr/share/applications/vidsync.desktop" "$APPDIR/vidsync.desktop"
18:25:14 out   cat > "$APPDIR/AppRun" <<'APPRUN'
18:25:14 out   #!/bin/sh
18:25:14 out   # AppRun for VIDSYNC. Keep ffmpeg and ffprobe next to the binary.
18:25:14 out   set -eu
18:25:14 out   HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
18:25:14 out   export APPDIR="$HERE"
18:25:14 out   export PATH="$HERE/usr/bin:${PATH:-/usr/bin:/bin}"
18:25:14 out   exec "$HERE/usr/bin/vidsync" "$@"
18:25:14 out   APPRUN
18:25:14 out   chmod +x "$APPDIR/AppRun"
18:25:14 out   if command -v desktop-file-validate >/dev/null 2>&1; then
18:25:14 out   desktop-file-validate "$APPDIR/usr/share/applications/vidsync.desktop" || true
18:25:14 out   fi
18:25:14 out   echo "==> Packing AppImage"
18:25:14 out   rm -f "$OUT"
18:25:14 out   APPIMAGE_EXTRACT_AND_RUN=1 ARCH="$ARCH" \
18:25:14 out   "$APPIMAGETOOL" --no-appstream "$APPDIR" "$OUT"
18:25:14 out   chmod +x "$OUT"
18:25:14 out   echo
18:25:14 out   echo "Built $OUT"
18:25:14 out   ls -lh "$OUT"
18:25:14 out   # VIDSYNC
18:25:14 out   VIDSYNC is a minimalist Linux video player that follows Audacity 4.0's playback
18:25:14 out   position. It reads the timecode Audacity already shows — `00h00m00.000s` — over
18:25:14 out   the desktop accessibility bus and scrolls the picture to the same time. It does
18:25:14 out   not send keys, take focus or care which window is on top. When Audacity plays
18:25:14 out   the picture moves; when Audacity pauses or stops the picture freezes.
18:25:14 out   The player shows video only. Audio is dropped, so it can run beside an audio
18:25:14 out   session without doubling the sound. There are no play, pause, record or start
18:25:14 out   controls: Audacity's transport is the only transport.
18:25:14 out   ```
18:25:14 out   ┌──────────────────────────────────────────────────────────────┐
18:25:14 out   │ ▶ VIDSYNC sample.mp4 ⚙ │
18:25:14 out   ├──────────────────────────────────────────────────────────────┤
18:25:14 out   │ │
18:25:14 out   │ video picture │
18:25:14 out   │ │
18:25:14 out   ├──────────────────────────────────────────────────────────────┤
18:25:14 out   │ ● Audacity 00:00:11.037 │
18:25:14 out   │ Following Audacity │
18:25:14 out   └──────────────────────────────────────────────────────────────┘
18:25:14 out   ```
18:25:14 out   ## What it does
18:25:14 out   - **Follows Audacity 4.0.** The timecode is read from Audacity's accessible
18:25:14 out   `Playback position` object about thirty times a second. It is independent of
18:25:14 out   window order, focus and stacking, so the player can stay behind or in front.
18:25:14 out   - **Green / red status dot.** Green means Audacity 4.0 is running and its
18:25:14 out   timecode display is set to `00h00m00.000s`; red means either was not found.
18:25:14 out   The matching `00:00:00.000` readout is shown on the right.
18:25:14 out   - **Moves with the clock.** A changing Audacity timecode scrolls the video in
18:25:14 out   real time. A still timecode holds the current frame. A backward jump, a seek,
18:25:14 out   or Audacity's stop-and-return-to-zero moves the picture with it.
18:25:14 out   - **Video only.** Audio, subtitle and data streams are dropped during decode.
18:25:14 out   - **Most formats.** Decoding is delegated to `ffmpeg`, so MP4, MKV, MOV, WebM,
18:25:14 out   AVI, MPEG, TS, MTS, OGV, FLV, WMV and other common containers work as long as
18:25:14 out   the bundled or system `ffmpeg` supports them.
18:25:14 out   - **Minimal interface.** A compact header, the picture, and one status bar.
18:25:14 out   The picture runs edge-to-edge between the header and the status bar, with
18:25:14 out   black letterbox or pillarbox bars protecting its aspect ratio. There is no
18:25:14 out   timecode entry field and no transport strip.
18:25:14 out   - **Optional appearance settings.** The gear offers Dark / Light and six accent
18:25:14 out   colours: orange, yellow, green, blue, purple and red. Dark and purple are the
18:25:14 out   defaults, and the chosen mode and colour are remembered on the next launch.
18:25:14 out   The menu, desktop and window icons use the same purple play tile shown beside
18:25:14 out   the name.
18:25:14 out   - **File browser and drag-and-drop.** No GTK dialogs are needed.
18:25:14 out   - **Ships as an AppImage** with `ffmpeg`/`ffprobe` inside, so the target machine
18:25:14 out   does not need ffmpeg installed.
18:25:14 out   ## Build and run
18:25:14 out   Requirements for building:
18:25:14 out   - Rust and Cargo (edition 2021)
18:25:14 out   - A Linux desktop with OpenGL and an accessibility bus
18:25:14 out   - `ffmpeg` and `ffprobe` for running from a normal build
18:25:14 out   - `curl`, `tar`, `xz` and `appimagetool` (downloaded automatically) for the
18:25:14 out   AppImage script
18:25:14 out   From this folder:
18:25:14 out   ```sh
18:25:14 out   cargo build --release
18:25:14 out   ./target/release/vidsync
18:25:14 out   ```
18:25:14 out   Open a file directly:
18:25:14 out   ```sh
18:25:14 out   ./target/release/vidsync /path/to/take.mp4
18:25:14 out   ```
18:25:14 out   Debug build and tests:
18:25:14 out   ```sh
18:25:14 out   cargo run
18:25:14 out   cargo build
18:25:14 out   cargo test
18:25:14 out   ```
18:25:14 out   The app looks for `ffmpeg` and `ffprobe` next to its executable first, then on
18:25:14 out   `PATH`. Override them with `CUE_FFMPEG` and `CUE_FFPROBE` if needed.
18:25:14 out   ## Connecting Audacity 4.0
18:25:14 out   1. Start Audacity 4.0 and leave its playback toolbar visible.
18:25:14 out   2. Set Audacity's timecode display to `00h00m00.000s` (the hour / minute /
18:25:14 out   second / millisecond form). The colon form still follows, but the status dot
18:25:14 out   stays red because it is not the requested display.
18:25:14 out   3. Start VIDSYNC and open a video. The dot turns green when Audacity's timecode
18:25:14 out   object is found.
18:25:14 out   4. Play, pause or stop in Audacity. VIDSYNC follows the readout; it never seeks
18:25:14 out   Audacity and never brings a window to the front.
18:25:14 out   If the dot stays red, make sure the desktop accessibility bus is running
18:25:14 out   (`org.a11y.Bus`) and that Audacity's playback toolbar is shown. Minimal window
18:25:14 out   managers sometimes start without it.
18:25:14 out   ## Controls
18:25:14 out   | Input | Action |
18:25:14 out   | --- | --- |
18:25:14 out   | O | Open the file browser |
18:25:14 out   | F or the header fullscreen button | Toggle fullscreen |
18:25:14 out   | Escape | Exit fullscreen, or close the settings panel |
18:25:14 out   | Drop a file on the window | Open it |
18:25:14 out   | Gear button | Appearance panel |
18:25:14 out   Fullscreen shows only the video on a black background; the header, status bar
18:25:14 out   and all other overlays are hidden. The picture keeps its aspect ratio, so black
18:25:14 out   bars appear when the screen shape differs from the video.
18:25:14 out   There are deliberately no playback buttons and no start-time field.
18:25:14 out   ## AppImage
18:25:14 out   Build the AppImage with:
18:25:14 out   ```sh
18:25:14 out   ./scripts/build-appimage.sh
18:25:14 out   ```
18:25:14 out   The script downloads the static `ffmpeg`/`ffprobe` build and `appimagetool`,
18:25:14 out   stages an AppDir under `build/`, and writes:
18:25:14 out   ```
18:25:14 out   dist/VIDSYNC-1.0.0-x86_64.AppImage
18:25:14 out   ```
18:25:14 out   Run it with:
18:25:14 out   ```sh
18:25:14 out   chmod +x dist/VIDSYNC-1.0.0-x86_64.AppImage
18:25:14 out   ./dist/VIDSYNC-1.0.0-x86_64.AppImage
18:25:14 out   ```
18:25:14 out   The AppImage contains its own ffmpeg and does not require FUSE to build. If your
18:25:14 out   system does not have FUSE, run it with
18:25:14 out   `./dist/VIDSYNC-1.0.0-x86_64.AppImage --appimage-extract-and-run`.
18:25:14 out   ## Verification flags
18:25:14 out   The binary supports two non-interactive modes used by the build checks:
18:25:14 out   ```sh
18:25:14 out   # Draw the app for ~120 frames, save a PNG, and exit.
18:25:14 out   ./target/release/vidsync --screenshot shots/now.png
18:25:14 out   # Drive the picture from a simulated Audacity clock, then write a JSON report.
18:25:14 out   ./target/release/vidsync --self-test shots/test.json
18:25:14 out   ```
18:25:14 out   The self-test writes `{"version": 1, "steps": [...]}` with `move`, `act` and
18:25:14 out   `hud` steps. Both modes use the embedded sample clip extracted to the system
18:25:14 out   temporary directory, so they work without any external media.
18:25:14 out   ## Project layout
18:25:14 out   | Path | Purpose |
18:25:14 out   | --- | --- |
18:25:14 out   | `src/main.rs` | app state, compact layout, drawing, screenshot/self-test |
18:25:14 out   | `src/player.rs` | ffprobe metadata, ffmpeg decode loop, follow and hold |
18:25:14 out   | `src/browser.rs` | in-app file browser |
18:25:14 out   | `src/audacity.rs` | AT-SPI timecode discovery, polling and movement detection |
18:25:14 out   | `src/ui.rs` | palette, themes, fonts, shapes, time formatting |
18:25:14 out   | `assets/sample.mp4` | small generated demo clip used by the welcome screen |
18:25:14 out   | `assets/vidsync.png` | app icon matching the in-app purple play logo |
18:25:14 out   | `assets/fonts/` | bundled DejaVu fonts (Bitstream Vera licence included) |
18:25:14 out   | `MECHANICS.md`, `mechanics.json` | values behind playback, follow and layout |
18:25:14 out   | `scripts/build-appimage.sh` | reproducible AppImage build |
18:25:14 out   ## Known limits
18:25:14 out   - The desktop accessibility bus must be available. VIDSYNC can switch it on, but
18:25:14 out   it cannot create one where none is installed.
18:25:14 out   - Audacity 4.0.2 on Linux is the version observed while building. The accessible
18:25:14 out   object name used here is `Playback position:00 h 00 m 00.000 s`. A translated
18:25:14 out   label still works as long as the name ends in a readable clock, and a bare
18:25:14 out   clock name also works; a future Audacity release could change the format.
18:25:14 out   - Audacity's stop action returns its play head to the start of the selection or
18:25:14 out   project; VIDSYNC follows that position, so the picture returns with it.
18:25:14 out   - Frame-accurate seeking depends on keyframes and on `ffmpeg`'s input seeking;
18:25:14 out   the picture is accurate to about a frame, not sample-accurate.
18:25:14 out   - Video is capped at 1280x720 and 30 fps to keep decode affordable. The cap can
18:25:14 out   be raised in `src/player.rs` (and in `mechanics.json`).
18:25:14 out   - The dark/light choice and accent colour are stored in
18:25:14 out   `$XDG_CONFIG_HOME/vidsync/settings.json` (usually under `.config`) and restored
18:25:14 out   on the next launch.
18:25:14 out   - The AppImage is built on x86_64; other architectures need their own static
18:25:14 out   ffmpeg and appimagetool build.
18:25:14 out   ## Licence
18:25:14 out   VIDSYNC is MIT licensed; see `LICENSE`. The bundled DejaVu fonts remain under the
18:25:14 out   Bitstream Vera licence in `assets/fonts/LICENSE-DejaVu.txt`.
18:25:14 out   # VIDSYNC mechanics
18:25:14 out   This sheet lists the values that shape VIDSYNC. There is no original program to
18:25:14 out   compare against, so design choices are marked **estimated**. Values taken from
18:25:14 out   the person's requests are marked with that source; values read from Audacity on
18:25:14 out   the build machine are marked **observed**. The same values live in
18:25:14 out   [`mechanics.json`](mechanics.json).
18:25:14 out   VIDSYNC is a video player, not a game. "Mechanics" here means following
18:25:14 out   Audacity 4.0's timecode, playback, the status bar and the small appearance
18:25:14 out   panel.
18:25:14 out   ## Following Audacity
18:25:14 out   The person asked for a player with no transport of its own: Audacity 4.0's
18:25:14 out   timecode is the clock, the player is the slave, and the hierarchy of desktop
18:25:14 out   windows must not matter.
18:25:14 out   | Value | Setting | Source |
18:25:14 out   | --- | --- | --- |
18:25:14 out   | Timecode source | AT-SPI accessible name `Playback position:00 h 00 m 00.000 s`; any short name ending in a clock also works | observed (Audacity 4.0.2) / fallback |
18:25:14 out   | Timecode readout format | `HH:MM:SS.mmm`, e.g. `00:00:11.037` | user request |
18:25:14 out   | Required Audacity display | `00h00m00.000s` for a green dot | user request |
18:25:14 out   | Green dot | Audacity found and timecode uses the hour/minute/second display | user request |
18:25:14 out   | Red dot | Audacity not found, or its timecode uses another display | user request |
18:25:14 out   | Window order | irrelevant; no focus or key injection | user request |
18:25:14 out   | Timecode poll interval | `33 ms` | estimated |
18:25:14 out   | Movement window | `220 ms` | estimated |
18:25:14 out   | Movement threshold | `0.0005 s` | estimated |
18:25:14 out   | Timecode jump threshold | `0.4 s` (restart the decoder nearby) | estimated |
18:25:14 out   | Still-frame refresh threshold | `0.02 s` | estimated |
18:25:14 out   | Audacity rediscovery interval | `12 s` | estimated |
18:25:14 out   | Failed discovery retry | `1 s` | estimated |
18:25:14 out   | Audacity version observed | `4.0.2` | observed (build machine) |
18:25:14 out   | Display server | any Linux desktop with AT-SPI, X11 or Wayland | observed / estimated |
18:25:14 out   The background thread walks the accessibility tree once, caches the node whose
18:25:14 out   name starts with `Playback position`, and reads it about thirty times a second.
18:25:14 out   A value that changes within the movement window marks Audacity as playing. The
18:25:14 out   UI then either follows the clock or holds a still frame. Nothing is sent to
18:25:14 out   Audacity and no window is raised, so the two applications can be stacked in any
18:25:14 out   order.
18:25:14 out   When Audacity is playing, VIDSYNC follows each reading. A drift of more than
18:25:14 out   `0.4 s` restarts `ffmpeg` from the new position; smaller drift is absorbed by
18:25:14 out   the decoder already running. When the clock stops changing, the decoder is
18:25:14 out   stopped and a still frame is fetched for the held position. If Audacity jumps
18:25:14 out   backwards, or its stop action returns the play head to zero, the picture follows
18:25:14 out   that jump.
18:25:14 out   ## Playback
18:25:14 out   | Value | Setting | Source |
18:25:14 out   | --- | --- | --- |
18:25:14 out   | Playback rate | `1.0x`, paced by the external timecode | user request |
18:25:14 out   | Output frame rate | `30 fps` | estimated |
18:25:14 out   | Maximum decoded width | `1280 px` | estimated |
18:25:14 out   | Maximum decoded height | `720 px` | estimated |
18:25:14 out   | Decoded frame queue | `12 frames` | estimated |
18:25:14 out   | Decoder channel buffer | `8 frames` | estimated |
18:25:14 out   | Longest accepted frame step | `0.1 s` | estimated |
18:25:14 out   | Audio output | none (audio streams are dropped) | user request |
18:25:14 out   | Supported formats | whatever the bundled `ffmpeg` can decode | user request |
18:25:14 out   Frames are decoded by `ffmpeg` to raw RGBA, scaled with bicubic filtering to fit
18:25:14 out   inside 1280x720 while preserving aspect ratio, and sampled at a fixed 30 fps.
18:25:14 out   The player displays the newest frame whose timestamp has been reached, so a slow
18:25:14 out   decode skips frames instead of slowing the follow. The image is letterboxed in
18:25:14 out   the window; it is never stretched.
18:25:14 out   `ffmpeg` decodes as fast as the machine allows, so the 12-frame queue keeps the
18:25:14 out   *earliest* frames and stops reading from the decoder while it is full. Draining
18:25:14 out   every available frame would throw away the pictures the clock is at and leave
18:25:14 out   only frames from seconds in the future. When Audacity runs past the end of a
18:25:14 out   short clip, the player parks on the last frame instead of restarting the
18:25:14 out   decoder on every timecode tick.
18:25:14 out   Audio, subtitles and data streams are explicitly dropped (`-an -sn -dn`). Video
18:25:14 out   codecs and containers are whatever the bundled/system `ffmpeg` can decode:
18:25:14 out   MP4, MKV, MOV, WebM, AVI, MPEG, TS, MTS, OGV, FLV, WMV and more.
18:25:14 out   ## Controls and transport
18:25:14 out   The person asked to remove the start-time field, the Audacity on/off switch and
18:25:14 out   the play, pause and record buttons. Audacity is the only transport.
18:25:14 out   | Value | Setting | Source |
18:25:14 out   | --- | --- | --- |
18:25:14 out   | Play button | none | user request |
18:25:14 out   | Pause button | none | user request |
18:25:14 out   | Record button | none | user request |
18:25:14 out   | Start-time field | none | user request |
18:25:14 out   | Audacity toggle switch | none | user request |
18:25:14 out   | Open shortcut | `O` | estimated |
18:25:14 out   | Fullscreen shortcut | `F` | estimated |
18:25:14 out   | Fullscreen button | header, beside the gear | user request |
18:25:14 out   | Exit fullscreen | `Escape` | user request |
18:25:14 out   | Close settings | `Escape` | estimated |
18:25:14 out   | Drag and drop | supported | estimated |
18:25:14 out   The header keeps only the wordmark, the current file name, an Open button, a
18:25:14 out   fullscreen button and the gear. The body is the picture and the status bar. The
18:25:14 out   status bar keeps the `Audacity` label, its green/red dot and the
18:25:14 out   `00:00:00.000` readout. Fullscreen removes the header, status bar and every
18:25:14 out   other overlay; only the picture and its black letterbox/pillarbox remain.
18:25:14 out   ## Interface, layout and themes
18:25:14 out   | Value | Setting | Source |
18:25:14 out   | --- | --- | --- |
18:25:14 out   | Window size | `1120x720` | estimated |
18:25:14 out   | Video viewport margin | `0 px`; flush to the window sides, header and status bar | user request |
18:25:14 out   | Top bar height | `52 px` normal, `44 px` compact | estimated |
18:25:14 out   | Status bar height | `70 px` normal, `58 px` compact | estimated |
18:25:14 out   | Status bar side padding | `18 px` normal, `12 px` compact | estimated |
18:25:14 out   | Timecode font | `32 px` normal, `22 px` compact, `18 px` narrow | estimated |
18:25:14 out   | Timecode area width | `280 px` normal, `200 px` compact, `160 px` narrow | estimated |
18:25:14 out   | Audacity label | `14 px` normal, `12 px` compact | estimated |
18:25:14 out   | Status dot | `4.5 px` radius, with a glow while following | estimated |
18:25:14 out   | Compact breakpoint | `880 px` window width | estimated |
18:25:14 out   | Narrowest layout breakpoint | `500 px` window width | estimated |
18:25:14 out   | Smallest tested window | `460x360` | estimated |
18:25:14 out   | Toast duration | `4.5 s` | estimated |
18:25:14 out   | File browser double-click window | `0.38 s` | estimated |
18:25:14 out   | Theme choices | `orange, yellow, green, blue, purple, red` | user request |
18:25:14 out   | Default theme | `purple` | user request |
18:25:14 out   | Interface modes | `dark, light` | user request |
18:25:14 out   | Default interface mode | `dark` | user request |
18:25:14 out   | Settings panel | `238x128 px` popover under the gear | estimated |
18:25:14 out   | Settings panel swatch | `24 px`, spaced `34 px` apart | estimated |
18:25:14 out   The layout switches to a compact status bar below 880 px wide: the bars get
18:25:14 out   shorter, the timecode drops to 22 px, the Audacity label drops to 12 px and the
18:25:14 out   side padding shrinks. Below 500 px the timecode drops to 18 px and its area
18:25:14 out   narrows to 160 px. The built-in file browser also drops its sidebar below
18:25:14 out   540 px and uses a smaller footer.
18:25:14 out   The gear opens an appearance popover rather than a separate settings window. A
18:25:14 out   Dark / Light choice switches the whole interface; dark is the default. Choosing
18:25:14 out   a swatch changes every accent immediately: the brand mark, play icon, settings
18:25:14 out   highlights and folder highlights. Both choices are saved to
18:25:14 out   `$XDG_CONFIG_HOME/vidsync/settings.json` and restored on the next launch, so a
18:25:14 out   missing file simply means dark and purple.
18:25:14 out   ## Sources and unknowns
18:25:14 out   - The latest request defines this version: no transport buttons, no start-time
18:25:14 out   field, no Audacity switch, a live `00:00:00.000` readout, a green/red dot for
18:25:14 out   Audacity and its `00h00m00.000s` display, a minimalist slave player, and
18:25:14 out   window-order independence.
18:25:14 out   - Audacity 4.0.2 was running on the build machine. Its accessible tree exposes
18:25:14 out   the name `Playback position:00 h 00 m 00.000 s`, and the value advanced while
18:25:14 out   Audacity played. VIDSYNC's live trace followed it and reset with Audacity's
18:25:14 out   stop-to-zero.
18:25:14 out   - Audacity 4.0 on other Linux desktops, and any future Audacity version, could
18:25:14 out   expose a different accessible name. VIDSYNC falls back to any short accessible
18:25:14 out   name that ends in a clock, so translated labels work, but a future release
18:25:14 out   could change the clock format itself.
18:25:14 out   - The accessibility bus must be running. VIDSYNC switches `IsEnabled` on, but
18:25:14 out   cannot install a missing AT-SPI stack.
18:25:14 out   - Every numeric layout value is a design choice for this build, not a copied
18:25:14 out   constant.
18:25:14 out   - Decode size and frame rate trade sharpness for CPU and memory; they can be
18:25:14 out   changed in `src/player.rs` and kept in step with `mechanics.json`.
