01:00:22 out   pub struct Snapshot {
01:00:22 out   pub connected: bool,
01:00:22 out   pub position: Option<f64>,
01:00:22 out   /// True while the timecode has changed recently, i.e. Audacity is running.
01:00:22 out   pub moving: bool,
01:00:22 out   /// True when Audacity's timecode display uses the requested
01:00:22 out   /// `00h00m00.000s` style rather than a bare colon clock.
01:00:22 out   pub format_ok: bool,
01:00:22 out   pub message: String,
01:00:22 out   }
01:00:22 out   struct TimecodeNode {
01:00:22 out   conn: Connection,
01:00:22 out   bus: String,
01:00:22 out   path: String,
01:00:22 out   }
01:00:22 out   impl TimecodeNode {
01:00:22 out   fn read(&self) -> Result<String, Box<dyn Error>> {
01:00:22 out   let props = Proxy::new(
01:00:22 out   &self.conn,
01:00:22 out   self.bus.as_str(),
