01:00:22 out   },
01:00:22 out   );
01:00:22 out   }
01:00:22 out   }
01:00:22 out   }
01:00:22 out   thread::sleep(POLL);
01:00:22 out   }
01:00:22 out   }
01:00:22 out   /// Audacity 4.0's timecode can be shown as `00h00m00.000s` or as a colon
01:00:22 out   /// clock. The person asked for the dot to turn green only for the hour /
01:00:22 out   /// minute / second display, so that choice is reported separately from the
