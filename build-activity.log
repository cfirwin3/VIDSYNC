16:08:00 out   #!/usr/bin/env bash
16:08:00 out   # Build a self-contained VidCue AppImage.
16:08:00 out   #
16:08:00 out   # ./scripts/build-appimage.sh
16:08:00 out   #
16:08:00 out   # It downloads a static ffmpeg/ffprobe build and appimagetool into build/cache
