14:38:41 out   pub fn fmt_time(seconds: f64, millis: bool) -> String {
14:38:41 out   let t = seconds.max(0.0);
14:38:41 out   let total_ms = (t * 1000.0).round() as u64;
14:38:41 out   let ms = total_ms % 1000;
14:38:41 out   let total = total_ms / 1000;
14:38:41 out   let h = total / 3600;
14:38:41 out   let m = (total % 3600) / 60;
14:38:41 out   let s = total % 60;
14:38:41 out   if millis {
14:38:41 out   format!("{:02}:{:02}:{:02}.{:03}", h, m, s, ms)
14:38:41 out   } else {
14:38:41 out   format!("{:02}:{:02}:{:02}", h, m, s)
14:38:41 out   }
14:38:41 out   }
14:38:41 out   /// Parse hours:minutes:seconds, minutes:seconds, or plain seconds.
14:38:41 out   /// Fractional seconds are accepted.
14:38:41 out   pub fn parse_time(input: &str) -> Option<f64> {
14:38:41 out   let s = input.trim();
14:38:41 out   if s.is_empty() {
14:38:41 out   return None;
14:38:41 out   }
14:38:41 out   let parts: Vec<&str> = s.split(':').collect();
14:38:41 out   if parts.len() > 3 {
14:38:41 out   return None;
14:38:41 out   }
14:38:41 out   let mut total = 0.0;
14:38:41 out   for (i, raw) in parts.iter().enumerate() {
14:38:41 out   let raw = raw.trim();
14:38:41 out   if raw.is_empty() {
14:38:41 out   return None;
14:38:41 out   }
14:38:41 out   let value: f64 = raw.parse().ok()?;
14:38:41 out   if !value.is_finite() || value < 0.0 {
14:38:41 out   return None;
14:38:41 out   }
14:38:41 out   let multiplier = match parts.len() - i {
14:38:41 out   1 => 1.0,
14:38:41 out   2 => 60.0,
14:38:41 out   3 => 3600.0,
14:38:41 out   _ => return None,
14:38:41 out   };
14:38:41 out   total += value * multiplier;
14:38:41 out   }
14:38:41 out   if total.is_finite() {
14:38:41 out   Some(total)
14:38:41 out   } else {
14:38:41 out   None
14:38:41 out   }
14:38:41 out   }
