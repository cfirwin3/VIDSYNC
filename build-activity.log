14:38:41 out   self.last_message = message.clone();
14:38:41 out   return Err(message);
14:38:41 out   };
14:38:41 out   let result: Result<(Window, String), String> = unsafe {
14:38:41 out   let dpy = (x.open_display)(ptr::null());
14:38:41 out   if dpy.is_null() {
14:38:41 out   Err("Could not open the X11 display".to_string())
14:38:41 out   } else {
14:38:41 out   let outcome = (|| {
14:38:41 out   let (target, title) = find_audacity(x, dpy).ok_or_else(|| {
14:38:41 out   "Audacity 4.0 window not found. Start Audacity and try again.".to_string()
14:38:41 out   })?;
14:38:41 out   let mut old_focus: Window = 0;
14:38:41 out   let mut revert_to: c_int = 0;
14:38:41 out   (x.get_input_focus)(dpy, &mut old_focus, &mut revert_to);
14:38:41 out   (x.raise_window)(dpy, target);
14:38:41 out   (x.set_input_focus)(dpy, target, REVERT_TO_PARENT, 0);
14:38:41 out   (x.sync)(dpy, 0);
14:38:41 out   let keysym = (x.string_to_keysym)(b"space\0".as_ptr() as *const c_char);
14:38:41 out   if keysym == 0 {
14:38:41 out   return Err("X11 could not find the Space key".to_string());
14:38:41 out   }
14:38:41 out   let keycode = (x.keysym_to_keycode)(dpy, keysym);
14:38:41 out   if keycode == 0 {
14:38:41 out   return Err("X11 could not map the Space key".to_string());
14:38:41 out   }
14:38:41 out   (x.test_fake_key_event)(dpy, keycode, 1, 0);
14:38:41 out   (x.test_fake_key_event)(dpy, keycode, 0, 0);
14:38:41 out   (x.sync)(dpy, 0);
14:38:41 out   // Give Audacity a moment to consume the key, then bring
14:38:41 out   // VidCue back to the front (not just give it the focus).
14:38:41 out   std::thread::sleep(std::time::Duration::from_millis(35));
