22:53:28 out   --- scripts/build-appimage.sh
22:53:28 out   #!/usr/bin/env bash
22:53:28 out   # Build a self-contained Cue Player AppImage.
22:53:28 out   #
22:53:28 out   # ./scripts/build-appimage.sh
22:53:28 out   #
22:53:28 out   # It downloads a static ffmpeg/ffprobe build and appimagetool into build/cache
22:53:28 out   # the first time, stages build/CuePlayer.AppDir, and writes dist/*.AppImage.
22:53:28 out   # No FUSE is needed: the tool is run with APPIMAGE_EXTRACT_AND_RUN=1.
22:53:28 out   set -euo pipefail
22:53:28 out   ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
22:53:28 out   cd "$ROOT"
22:53:28 out   APP="CuePlayer"
22:53:28 out   ARCH="${ARCH:-x86_64}"
22:53:28 out   VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
22:53:28 out   if [ -z "$VERSION" ]; then
22:53:28 out   echo "Could not read the version from Cargo.toml" >&2
22:53:28 out   exit 1
22:53:28 out   fi
22:53:28 out   case "$ARCH" in
22:53:28 out   x86_64)
22:53:28 out   FFMPEG_URL="https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
22:53:28 out   APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
22:53:28 out   ;;
22:53:28 out   *)
22:53:28 out   echo "Only x86_64 AppImages are supported by this script (got ARCH=$ARCH)." >&2
22:53:28 out   echo "Set ARCH=x86_64 or adapt the download URLs." >&2
22:53:28 out   exit 1
22:53:28 out   ;;
22:53:28 out   esac
22:53:28 out   BUILD="$ROOT/build"
22:53:28 out   CACHE="$BUILD/cache"
22:53:28 out   APPDIR="$BUILD/$APP.AppDir"
22:53:28 out   DIST="$ROOT/dist"
22:53:28 out   BIN="$ROOT/target/release/cue-video-player"
22:53:28 out   FF_DIR="$CACHE/ffmpeg-static"
22:53:28 out   FF_ARCHIVE="$CACHE/ffmpeg-static.tar.xz"
22:53:28 out   APPIMAGETOOL="$CACHE/appimagetool-$ARCH.AppImage"
22:53:28 out   OUT="$DIST/$APP-$VERSION-$ARCH.AppImage"
22:53:28 out   need() {
22:53:28 out   command -v "$1" >/dev/null 2>&1 || {
22:53:28 out   echo "Missing required command: $1" >&2
22:53:28 out   exit 1
22:53:28 out   }
22:53:28 out   }
22:53:28 out   need cargo
22:53:28 out   need curl
22:53:28 out   need tar
22:53:28 out   need xz
22:53:28 out   echo "==> Building release binary"
22:53:28 out   cargo build --release --locked
22:53:28 out   echo "==> Preparing build folders"
22:53:28 out   mkdir -p "$CACHE" "$DIST"
22:53:28 out   rm -rf "$APPDIR"
22:53:28 out   mkdir -p "$APPDIR/usr/bin" \
22:53:28 out   "$APPDIR/usr/share/applications" \
22:53:28 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps" \
22:53:28 out   "$APPDIR/usr/share/doc/cue-player"
22:53:28 out   echo "==> Fetching static ffmpeg and ffprobe (cached)"
22:53:28 out   if [ ! -x "$FF_DIR/ffmpeg" ] || [ ! -x "$FF_DIR/ffprobe" ]; then
22:53:28 out   if [ ! -f "$FF_ARCHIVE" ]; then
22:53:28 out   curl -fL --retry 3 --retry-delay 2 -o "$FF_ARCHIVE" "$FFMPEG_URL"
22:53:28 out   fi
22:53:28 out   rm -rf "$FF_DIR"
22:53:28 out   mkdir -p "$FF_DIR"
22:53:28 out   tar -xJf "$FF_ARCHIVE" -C "$FF_DIR" --strip-components=1
22:53:28 out   fi
22:53:28 out   echo "==> Fetching appimagetool (cached)"
22:53:28 out   if [ ! -x "$APPIMAGETOOL" ]; then
22:53:28 out   if [ ! -f "$APPIMAGETOOL" ]; then
22:53:28 out   curl -fL --retry 3 --retry-delay 2 -o "$APPIMAGETOOL" "$APPIMAGETOOL_URL"
22:53:28 out   fi
22:53:28 out   chmod +x "$APPIMAGETOOL"
22:53:28 out   fi
22:53:28 out   echo "==> Staging AppDir"
22:53:28 out   install -Dm755 "$BIN" "$APPDIR/usr/bin/cue-video-player"
22:53:28 out   install -Dm755 "$FF_DIR/ffmpeg" "$APPDIR/usr/bin/ffmpeg"
22:53:28 out   install -Dm755 "$FF_DIR/ffprobe" "$APPDIR/usr/bin/ffprobe"
22:53:28 out   install -Dm644 "$ROOT/assets/cue-player.png" \
22:53:28 out   "$APPDIR/usr/share/icons/hicolor/256x256/apps/cue-player.png"
22:53:28 out   install -Dm644 "$ROOT/scripts/cue-player.desktop" \
22:53:28 out   "$APPDIR/usr/share/applications/cue-player.desktop"
22:53:28 out   install -Dm644 "$ROOT/README.md" "$APPDIR/usr/share/doc/cue-player/README.md"
22:53:28 out   install -Dm644 "$ROOT/MECHANICS.md" "$APPDIR/usr/share/doc/cue-player/MECHANICS.md"
22:53:28 out   install -Dm644 "$ROOT/LICENSE" "$APPDIR/usr/share/doc/cue-player/LICENSE"
22:53:28 out   install -Dm644 "$ROOT/assets/fonts/LICENSE-DejaVu.txt" \
22:53:28 out   "$APPDIR/usr/share/doc/cue-player/LICENSE-DejaVu.txt"
22:53:28 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/cue-player.png" "$APPDIR/cue-player.png"
22:53:28 out   cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/cue-player.png" "$APPDIR/.DirIcon"
22:53:28 out   cp "$APPDIR/usr/share/applications/cue-player.desktop" "$APPDIR/cue-player.desktop"
22:53:28 out   cat > "$APPDIR/AppRun" <<'APPRUN'
22:53:28 out   #!/bin/sh
22:53:28 out   # AppRun for Cue Player. Keep ffmpeg and ffprobe next to the binary.
22:53:28 out   set -eu
22:53:28 out   HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
22:53:28 out   export APPDIR="$HERE"
22:53:28 out   export PATH="$HERE/usr/bin:${PATH:-/usr/bin:/bin}"
22:53:28 out   exec "$HERE/usr/bin/cue-video-player" "$@"
22:53:28 out   APPRUN
22:53:28 out   chmod +x "$APPDIR/AppRun"
22:53:28 out   if command -v desktop-file-validate >/dev/null 2>&1; then
22:53:28 out   desktop-file-validate "$APPDIR/usr/share/applications/cue-player.desktop" || true
22:53:28 out   fi
22:53:28 out   echo "==> Packing AppImage"
22:53:28 out   rm -f "$OUT"
22:53:28 out   APPIMAGE_EXTRACT_AND_RUN=1 ARCH="$ARCH" \
22:53:28 out   "$APPIMAGETOOL" --no-appstream "$APPDIR" "$OUT"
22:53:28 out   chmod +x "$OUT"
22:53:28 out   echo
22:53:28 out   echo "Built $OUT"
22:53:28 out   ls -lh "$OUT"
