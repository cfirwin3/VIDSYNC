00:41:15 out   #!/usr/bin/env python3
00:41:15 out   """Draw the Cue Player app icon.
00:41:15 out   Run from the app folder: python3 scripts/make-icon.py
00:41:15 out   Requires Pillow. The committed PNG is used by the AppImage build; this script
00:41:15 out   exists so the icon can be regenerated or recoloured later.
00:41:15 out   """
00:41:15 out   from pathlib import Path
00:41:15 out   from PIL import Image, ImageDraw
00:41:15 out   ROOT = Path(__file__).resolve().parent.parent
00:41:15 out   OUT = ROOT / "assets" / "cue-player.png"
00:41:15 out   BG = (11, 13, 16, 255)
00:41:15 out   PANEL = (28, 32, 39, 255)
00:41:15 out   AMBER = (230, 165, 74, 255)
00:41:15 out   BRIGHT = (248, 186, 94, 255)
00:41:15 out   DARK = (20, 17, 12, 255)
00:41:15 out   def build(size: int) -> Image.Image:
00:41:15 out   s = size / 512.0
00:41:15 out   def r(*values):
00:41:15 out   return tuple(round(v * s) for v in values)
00:41:15 out   img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
00:41:15 out   d = ImageDraw.Draw(img)
00:41:15 out   d.rounded_rectangle(r(12, 12, 500, 500), radius=r(112)[0], fill=BG,
00:41:15 out   outline=AMBER, width=max(1, r(9)[0]))
00:41:15 out   # Film strip holes along the top and bottom.
00:41:15 out   for x in (92, 172, 252, 332, 412):
00:41:15 out   d.rounded_rectangle(r(x, 56, x + 36, 82), radius=r(6)[0], fill=PANEL)
00:41:15 out   d.rounded_rectangle(r(x, 430, x + 36, 456), radius=r(6)[0], fill=PANEL)
00:41:15 out   # Amber play mark.
00:41:15 out   d.polygon(
00:41:15 out   [r(198, 150), r(198, 362), r(372, 256)],
00:41:15 out   fill=AMBER,
00:41:15 out   )
00:41:15 out   d.polygon(
00:41:15 out   [r(216, 188), r(216, 324), r(328, 256)],
00:41:15 out   fill=BRIGHT,
00:41:15 out   )
00:41:15 out   # Dark pupil in the play mark keeps it from looking like a solid wedge.
00:41:15 out   d.polygon(
00:41:15 out   [r(212, 192), r(212, 320), r(318, 256)],
00:41:15 out   fill=DARK,
00:41:15 out   )
00:41:15 out   return img
00:41:15 out   def main() -> None:
00:41:15 out   OUT.parent.mkdir(parents=True, exist_ok=True)
00:41:15 out   build(512).resize((256, 256), Image.LANCZOS).save(OUT)
00:41:15 out   print(f"wrote {OUT}")
00:41:15 out   if __name__ == "__main__":
00:41:15 out   main()
