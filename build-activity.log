16:04:47 out   }
16:04:47 out   pub fn film_icon(x: f32, y: f32, w: f32, h: f32, color: Color) {
16:04:47 out   rounded_rect(x, y, w, h, 8.0, color);
16:04:47 out   let hole = bg();
16:04:47 out   let n = 4;
16:04:47 out   let hw = w * 0.045;
16:04:47 out   for i in 0..n {
16:04:47 out   let yy = y + 8.0 + i as f32 * ((h - 16.0) / (n - 1) as f32) - hw;
16:04:47 out   rounded_rect(x + 7.0, yy, hw, hw, 1.2, hole);
16:04:47 out   rounded_rect(x + w - 7.0 - hw, yy, hw, hw, 1.2, hole);
16:04:47 out   }
16:04:47 out   // Lens / play mark in the middle.
16:04:47 out   play_icon(x + w * 0.53, y + h * 0.5, h * 0.22, hole);
16:04:47 out   }
